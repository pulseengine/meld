# Rust build artifacts
target/
**/*.rs.bk

# Bazel build artifacts
bazel-*
/bazel-*

# WASM artifacts (generated)
*.wasm
*.wat
!tests/**/*.wat
!examples/**/*.wat

# Profiling
**/*.profraw
*.profdata

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment and credentials
.env
*.key
credentials.json

# Local Bazel overrides
.bazelrc.local

# Build cache
.cargo/

# Test output
test-output/

# Local LS-N verification gate output
verification-results.json

# Claude local files
.claude/

# Nix / direnv
.direnv/

# Coq/Rocq auxiliary files
*.aux
*.glob
# Rocq/Coq build artifacts. `*.glob` was already here; these three were not,
# so a local `coqc` run left them as untracked noise (#447 — nobody had ever
# compiled the proofs locally, so nobody had hit it).
*.vo
*.vok
*.vos
# `nia`/`lia` leave these next to the proofs.
.nia.cache
.lia.cache
.lia.cache
