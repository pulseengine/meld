(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (func $hs (param $h i32) (param $p i32) (param $len i32) (result i32)
        (local $i i32) (local $n i32)
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $len)))
        (if (i32.and (local.get $len) (i32.const 0x80000000))
          (then (local.set $n (i32.and (local.get $len) (i32.const 0x7fffffff)))
            (loop $l (if (i32.lt_u (local.get $i) (local.get $n)) (then
              (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1))))))
              (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l)))))
          (else (local.set $n (local.get $len))
            (loop $l (if (i32.lt_u (local.get $i) (local.get $n)) (then
              (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load8_u (i32.add (local.get $p) (local.get $i)))))
              (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))))
        (local.get $h))
      (func $hl (param $h i32) (param $p i32) (param $n i32) (result i32)
        (local $i i32)
        (loop $l (if (i32.lt_u (local.get $i) (local.get $n)) (then
          (local.set $h (call $hs (local.get $h)
            (i32.load (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 3))))
            (i32.load (i32.add (local.get $p) (i32.add (i32.shl (local.get $i) (i32.const 3)) (i32.const 4))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
        (local.get $h))
      ;; hash the received list, return [string holding the 4 hash bytes, string with OOB utf16 pointer]
      (func (export "uf") (param $p i32) (param $n i32) (result i32)
        (local $h i32)
        (local.set $h (call $hl (i32.const 0) (local.get $p) (local.get $n)))
        (i32.store (i32.const 2100) (local.get $h))
        (i32.store (i32.const 2048) (i32.const 2100))
        (i32.store (i32.const 2052) (i32.const 4))
        (i32.store (i32.const 2056) (i32.const 65532)) ;; element 1: ptr+6 bytes runs past memory end
        (i32.store (i32.const 2060) (i32.const 0x80000003))
        (i32.store (i32.const 2200) (i32.const 2048))
        (i32.store (i32.const 2204) (i32.const 2))
        (i32.const 2200))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "l" (list string)) (result (list string))
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (param "l" (list string)) (result (list string))))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; list of 4 strings at 64: "caf\e9" (latin1), "€𝄞" (utf16, 3 units), "", "xyz"
      (data (i32.const 64) "\80\00\00\00\04\00\00\00\88\00\00\00\03\00\00\80\00\00\00\00\00\00\00\00\a0\00\00\00\03\00\00\00")
      (data (i32.const 128) "caf\e9")
      (data (i32.const 136) "\ac\20\34\d8\1e\dd")
      (data (i32.const 160) "xyz"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=latin1+utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32 i32)))
      (func $hs (param $h i32) (param $p i32) (param $len i32) (result i32)
        (local $i i32) (local $n i32)
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $len)))
        (if (i32.and (local.get $len) (i32.const 0x80000000))
          (then (local.set $n (i32.and (local.get $len) (i32.const 0x7fffffff)))
            (loop $l (if (i32.lt_u (local.get $i) (local.get $n)) (then
              (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1))))))
              (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l)))))
          (else (local.set $n (local.get $len))
            (loop $l (if (i32.lt_u (local.get $i) (local.get $n)) (then
              (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load8_u (i32.add (local.get $p) (local.get $i)))))
              (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))))
        (local.get $h))
      (func (export "run") (result i32)
        (local $h i32) (local $i i32) (local $p i32) (local $n i32)
        (call $f (i32.const 64) (i32.const 4) (i32.const 512))
        (local.set $p (i32.load (i32.const 512)))
        (local.set $n (i32.load (i32.const 516)))
        (local.set $h (local.get $n))
        (loop $l (if (i32.lt_u (local.get $i) (local.get $n)) (then
          (local.set $h (call $hs (local.get $h)
            (i32.load (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 3))))
            (i32.load (i32.add (local.get $p) (i32.add (i32.shl (local.get $i) (i32.const 3)) (i32.const 4))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
        (local.get $h))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
