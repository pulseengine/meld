(component
  (component $C
    (type $r0 (record (field "id" u32) (field "name" string) (field "tag" char)))
    (export $rec "rec" (type $r0))
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params-ptr: id@0, name ptr@4, name tagged len@8, tag@12, a1..a13 @16..
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $len i32) (local $sp i32) (local $i i32) (local $n i32) (local $w i32)
        (local.set $h (i32.load (local.get $p)))
        (local.set $len (i32.load offset=8 (local.get $p)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $len)))
        (local.set $sp (i32.load offset=4 (local.get $p)))
        (local.set $w (i32.shr_u (local.get $len) (i32.const 31)))
        (local.set $n (i32.and (local.get $len) (i32.const 0x7fffffff)))
        (block $done1 (loop $l1
          (br_if $done1 (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (if (result i32) (local.get $w)
              (then (i32.load16_u (i32.add (local.get $sp) (i32.shl (local.get $i) (i32.const 1)))))
              (else (i32.load8_u (i32.add (local.get $sp) (local.get $i)))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l1)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=12 (local.get $p))))
        (local.set $i (i32.const 0))
        (block $done2 (loop $l2
          (br_if $done2 (i32.ge_u (local.get $i) (i32.const 13)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (i32.load offset=16 (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l2)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "r" $rec) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (result u32)
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $r0 (record (field "id" u32) (field "name" string) (field "tag" char)))
    (import "rec" (type $rec (eq $r0)))
    (import "uf" (func $f (param "r" $rec) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; utf16 name e-acute, euro sign, astral char = E9 00 AC 20 3D D8 00 DE
      (data (i32.const 64) "\e9\00\ac\20\3d\d8\00\de")
      ;; args struct @128: id=0x1234, ptr=64, tagged len=0x80000004, tag=0xDFFF (lone surrogate)
      (data (i32.const 128) "\34\12\00\00\40\00\00\00\04\00\00\80\ff\df\00\00")
      ;; a1..a13
      (data (i32.const 144) "\07\00\00\00\0e\00\00\00\15\00\00\00\1c\00\00\00\23\00\00\00\2a\00\00\00\31\00\00\00\38\00\00\00\3f\00\00\00\46\00\00\00\4d\00\00\00\54\00\00\00\5b\00\00\00"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=latin1+utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func (export "run") (result i32)
        (call $f (i32.const 128))))
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "rec" (type $c "rec")) (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
