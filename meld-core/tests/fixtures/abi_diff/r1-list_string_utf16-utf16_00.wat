(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (func $mix (param $h i32) (param $x i32) (result i32)
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $x)))
      (func $hstr (param $h i32) (param $p i32) (param $n i32) (result i32)
        (local $i i32)
        (local.set $h (call $mix (local.get $h) (local.get $n)))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $h (call $mix (local.get $h) (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.get $h))
      ;; params-ptr -> retptr; hashes list<string> + 15 u32s, returns list [hash-string, OOB string, echo of elem 0]
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $lp i32) (local $n i32) (local $j i32) (local $s i32) (local $out i32) (local $ret i32)
        (local.set $lp (i32.load (local.get $p)))
        (local.set $n (i32.load offset=4 (local.get $p)))
        (local.set $h (call $mix (i32.const 0) (local.get $n)))
        (block $d1 (loop $l1
          (br_if $d1 (i32.ge_u (local.get $j) (local.get $n)))
          (local.set $h (call $hstr (local.get $h)
            (i32.load (i32.add (local.get $lp) (i32.shl (local.get $j) (i32.const 3))))
            (i32.load offset=4 (i32.add (local.get $lp) (i32.shl (local.get $j) (i32.const 3))))))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (br $l1)))
        (local.set $j (i32.const 0))
        (block $d2 (loop $l2
          (br_if $d2 (i32.ge_u (local.get $j) (i32.const 15)))
          (local.set $h (call $mix (local.get $h) (i32.load offset=8 (i32.add (local.get $p) (i32.shl (local.get $j) (i32.const 2))))))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (br $l2)))
        (local.set $s (call $realloc_ (i32.const 16)))
        (local.set $j (i32.const 0))
        (block $d3 (loop $l3
          (br_if $d3 (i32.ge_u (local.get $j) (i32.const 8)))
          (i32.store16 (i32.add (local.get $s) (i32.shl (local.get $j) (i32.const 1)))
            (i32.add (i32.const 0x4E00) (i32.and (i32.shr_u (local.get $h) (i32.shl (local.get $j) (i32.const 2))) (i32.const 15))))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (br $l3)))
        (local.set $out (call $realloc_ (i32.const 24)))
        (i32.store (local.get $out) (local.get $s))
        (i32.store offset=4 (local.get $out) (i32.const 8))
        (i32.store offset=8 (local.get $out) (i32.const 65534))
        (i32.store offset=12 (local.get $out) (i32.const 4))
        (i32.store offset=16 (local.get $out) (i32.load (local.get $lp)))
        (i32.store offset=20 (local.get $out) (i32.load offset=4 (local.get $lp)))
        (local.set $ret (call $realloc_ (i32.const 8)))
        (i32.store (local.get $ret) (local.get $out))
        (i32.store offset=4 (local.get $ret) (i32.const 3))
        (local.get $ret))
      (func $realloc_ (param $n i32) (result i32)
        (local $r i32)
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $n)))
        (local.get $r))
    )
    (core instance $m (instantiate $M))
    (func (export "uf")
      (param "l" (list string)) (param "a" u32) (param "b" u32) (param "c" u32) (param "d" u32) (param "e" u32)
      (param "f" u32) (param "g" u32) (param "h" u32) (param "i" u32) (param "j" u32)
      (param "k" u32) (param "m" u32) (param "n" u32) (param "o" u32) (param "p" u32)
      (result (list string))
      (canon lift (core func $m "uf") string-encoding=utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f
      (param "l" (list string)) (param "a" u32) (param "b" u32) (param "c" u32) (param "d" u32) (param "e" u32)
      (param "f" u32) (param "g" u32) (param "h" u32) (param "i" u32) (param "j" u32)
      (param "k" u32) (param "m" u32) (param "n" u32) (param "o" u32) (param "p" u32)
      (result (list string))))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (local.get $r))
      (data (i32.const 512) "\61\00\e9\00\ac\20")
      (data (i32.const 528) "\3d\d8\00\de\7a\00"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32)))
      (func $mix (param $h i32) (param $x i32) (result i32)
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $x)))
      (func (export "run") (result i32)
        (local $i i32) (local $h i32) (local $lp i32) (local $n i32) (local $sp i32) (local $sn i32) (local $u i32)
        (i32.store (i32.const 256) (i32.const 512)) (i32.store (i32.const 260) (i32.const 3))
        (i32.store (i32.const 264) (i32.const 544)) (i32.store (i32.const 268) (i32.const 0))
        (i32.store (i32.const 272) (i32.const 528)) (i32.store (i32.const 276) (i32.const 3))
        (i32.store (i32.const 128) (i32.const 256)) (i32.store (i32.const 132) (i32.const 3))
        (block $d (loop $l
          (br_if $d (i32.ge_u (local.get $i) (i32.const 15)))
          (i32.store offset=136 (i32.shl (local.get $i) (i32.const 2))
            (i32.add (i32.mul (local.get $i) (i32.const 7)) (i32.const 3)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (call $f (i32.const 128) (i32.const 96))
        (local.set $lp (i32.load (i32.const 96)))
        (local.set $n (i32.load (i32.const 100)))
        (local.set $h (local.get $n))
        (local.set $i (i32.const 0))
        (block $d2 (loop $l2
          (br_if $d2 (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $sp (i32.load (i32.add (local.get $lp) (i32.shl (local.get $i) (i32.const 3)))))
          (local.set $sn (i32.load offset=4 (i32.add (local.get $lp) (i32.shl (local.get $i) (i32.const 3)))))
          (local.set $h (call $mix (local.get $h) (local.get $sn)))
          (local.set $u (i32.const 0))
          (block $d3 (loop $l3
            (br_if $d3 (i32.ge_u (local.get $u) (local.get $sn)))
            (local.set $h (call $mix (local.get $h) (i32.load16_u (i32.add (local.get $sp) (i32.shl (local.get $u) (i32.const 1))))))
            (local.set $u (i32.add (local.get $u) (i32.const 1)))
            (br $l3)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l2)))
        (local.get $h))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
