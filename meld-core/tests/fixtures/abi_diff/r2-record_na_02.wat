(component
  (component $C
    (type $rd (record (field "a" u8) (field "b" u32) (field "c" u64) (field "d" f32) (field "e" bool)))
    (export $r "r" (type $rd))
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; hash of all flat fields: a, b, c.lo, c.hi, d bits, e
      (func (export "uf") (param $a i32) (param $b i32) (param $c i64) (param $d f32) (param $e i32) (result i32)
        (local $h i32)
        (local.set $h (local.get $a))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $b)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.wrap_i64 (local.get $c))))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.wrap_i64 (i64.shr_u (local.get $c) (i64.const 32)))))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.reinterpret_f32 (local.get $d))))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $e)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "r" $r) (result u32)
      (canon lift (core func $m "uf")
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $rd (record (field "a" u8) (field "b" u32) (field "c" u64) (field "d" f32) (field "e" bool)))
    (import "r" (type $r (eq $rd)))
    (import "uf" (func $f (param "r" $r) (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r)))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f)
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32 i64 f32 i32) (result i32)))
      (func (export "run") (result i32)
        (call $f
          (i32.const 200)                  ;; a: u8
          (i32.const 0x80000001)           ;; b: u32 with high bit
          (i64.const 0x0123456789ABCDEF)   ;; c: u64
          (f32.const -2.5)                 ;; d: f32
          (i32.const 256)                  ;; e: bool, malformed (> 1, low byte is 0)
        ))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "r" (type $c "r")) (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
