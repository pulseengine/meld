      ;; tuple of 18 fields at 64; padding bytes are zero
      (data (i32.const 64)
        "\e9\00\00\00" "\fe\00\00\00" "\ac\20\00\00" "\ef\be\00\00"
        "\00\f6\01\00" "\ff\ff\10\00" "\ff\d7\00\00" "\00\e0\00\00"
