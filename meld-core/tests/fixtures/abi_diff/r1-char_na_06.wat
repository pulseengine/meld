    (func (export "uf") (param "c0" char) (param "b" u8) (param "c1" char) (param "h" u16) (param "c2" char) (param "c3" char) (param "c4" char) (param "c5" char) (param "c6" char) (param "c7" char) (param "c8" char) (param "c9" char) (param "c10" char) (param "c11" char) (param "u" u32) (param "c12" char) (param "c13" char) (param "b2" u8) (result u32)
