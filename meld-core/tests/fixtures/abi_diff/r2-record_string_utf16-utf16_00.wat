(component
  (component $C
    (type $R0 (record (field "id" u32) (field "name" string) (field "tag" char) (field "x0" u32) (field "x1" u32) (field "x2" u32) (field "x3" u32) (field "x4" u32) (field "x5" u32) (field "x6" u32) (field "x7" u32) (field "x8" u32) (field "x9" u32) (field "x10" u32) (field "x11" u32) (field "x12" u32) (field "x13" u32)))
    (export $R "r" (type $R0))
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params-ptr: id@0, name ptr@4, name len@8, tag@12, x0..x13 @16..
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $i i32) (local $n i32) (local $s i32)
        (local.set $h (i32.load (local.get $p)))
        (local.set $s (i32.load offset=4 (local.get $p)))
        (local.set $n (i32.load offset=8 (local.get $p)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $n)))
        (block $d1 (loop $l1
          (br_if $d1 (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (i32.load16_u (i32.add (local.get $s) (i32.shl (local.get $i) (i32.const 1))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l1)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=12 (local.get $p))))
        (local.set $i (i32.const 0))
        (block $d2 (loop $l2
          (br_if $d2 (i32.ge_u (local.get $i) (i32.const 14)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (i32.load (i32.add (i32.add (local.get $p) (i32.const 16)) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l2)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "r" $R) (result u32)
      (canon lift (core func $m "uf") string-encoding=utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $R0 (record (field "id" u32) (field "name" string) (field "tag" char) (field "x0" u32) (field "x1" u32) (field "x2" u32) (field "x3" u32) (field "x4" u32) (field "x5" u32) (field "x6" u32) (field "x7" u32) (field "x8" u32) (field "x9" u32) (field "x10" u32) (field "x11" u32) (field "x12" u32) (field "x13" u32)))
    (import "r" (type $R (eq $R0)))
    (import "uf" (func $f (param "r" $R) (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; utf16: a, e-acute, euro, U+1F600 (surrogate pair), z
      (data (i32.const 64) "\61\00\e9\00\ac\20\3d\d8\00\de\7a\00"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func (export "run") (result i32)
        (local $i i32)
        (i32.store (i32.const 256) (i32.const 0xC0FFEE))
        (i32.store (i32.const 260) (i32.const 64))
        (i32.store (i32.const 264) (i32.const 6))
        (i32.store (i32.const 268) (i32.const 0x1F680))
        (block $d (loop $l
          (br_if $d (i32.ge_u (local.get $i) (i32.const 14)))
          (i32.store (i32.add (i32.const 272) (i32.shl (local.get $i) (i32.const 2)))
            (i32.add (i32.mul (local.get $i) (i32.const 0x01010101)) (i32.const 7)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (call $f (i32.const 256)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "r" (type $c "r")) (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
