(component
  (component $C
    (type $vd (variant (case "a") (case "b" u8) (case "c" u64) (case "d" char)))
    (export $v "v" (type $vd))
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func $realloc (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (func $fold (param $h i64) (param $d i32) (param $p i64) (result i64)
        (local.set $h (i64.add (i64.mul (local.get $h) (i64.const 31)) (i64.extend_i32_u (local.get $d))))
        (if (i32.ne (local.get $d) (i32.const 0))
          (then (local.set $h (i64.add (i64.mul (local.get $h) (i64.const 31)) (local.get $p)))))
        (local.get $h))
      ;; four variants in (disc, joined i64 payload) form; returns ptr to variant c(hash)
      (func (export "uf") (param $d1 i32) (param $p1 i64) (param $d2 i32) (param $p2 i64) (param $d3 i32) (param $p3 i64) (param $d4 i32) (param $p4 i64) (result i32)
        (local $h i64) (local $r i32)
        (local.set $h (call $fold (i64.const 0) (local.get $d1) (local.get $p1)))
        (local.set $h (call $fold (local.get $h) (local.get $d2) (local.get $p2)))
        (local.set $h (call $fold (local.get $h) (local.get $d3) (local.get $p3)))
        (local.set $h (call $fold (local.get $h) (local.get $d4) (local.get $p4)))
        (local.set $r (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 16)))
        (i32.store8 (local.get $r) (i32.const 2))
        (i64.store (i32.add (local.get $r) (i32.const 8)) (local.get $h))
        (local.get $r))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "a" $v) (param "b" $v) (param "c" $v) (param "d" $v) (result $v)
      (canon lift (core func $m "uf")
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $vd (variant (case "a") (case "b" u8) (case "c" u64) (case "d" char)))
    (import "v" (type $v (eq $vd)))
    (import "uf" (func $f (param "a" $v) (param "b" $v) (param "c" $v) (param "d" $v) (result $v)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r)))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f)
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i64 i32 i64 i32 i64 i32 i64 i32)))
      (func (export "run") (result i32)
        (local $h i32) (local $p i64)
        ;; b(0xC3), d(U+1F980), c(0xFEDCBA9876543210), a ; retptr = 256
        (call $f (i32.const 1) (i64.const 0xC3)
                 (i32.const 3) (i64.const 0x1F980)
                 (i32.const 2) (i64.const 0xFEDCBA9876543210)
                 (i32.const 0) (i64.const 0)
                 (i32.const 256))
        (local.set $h (i32.load8_u (i32.const 256)))
        (local.set $p (i64.load (i32.const 264)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.wrap_i64 (local.get $p))))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.wrap_i64 (i64.shr_u (local.get $p) (i64.const 32)))))
        (local.get $h))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "v" (type $c "v")) (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
