(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params-ptr tuple: list(ptr,len) at 0, then 15 u32 at 8..68
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $i i32) (local $n i32) (local $lp i32) (local $q i32) (local $sp i32) (local $sl i32) (local $j i32)
        (local.set $lp (i32.load (local.get $p)))
        (local.set $n (i32.load offset=4 (local.get $p)))
        (local.set $h (local.get $n))
        (block $done (loop $outer
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $q (i32.add (local.get $lp) (i32.shl (local.get $i) (i32.const 3))))
          (local.set $sp (i32.load (local.get $q)))
          (local.set $sl (i32.load offset=4 (local.get $q)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $sl)))
          (local.set $j (i32.const 0))
          (block $sd (loop $inner
            (br_if $sd (i32.ge_u (local.get $j) (local.get $sl)))
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load8_u (i32.add (local.get $sp) (local.get $j)))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $inner)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $outer)))
        (local.set $i (i32.const 0))
        (block $d2 (loop $l2
          (br_if $d2 (i32.ge_u (local.get $i) (i32.const 15)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (i32.load offset=8 (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l2)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "l" (list string))
      (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32)
      (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32)
      (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32) (result u32)
      (canon lift (core func $m "uf") string-encoding=utf8
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (param "l" (list string))
      (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32)
      (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32)
      (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32) (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 2048))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (data (i32.const 256) "abc")
      (data (i32.const 272) "caf\e9")
      (data (i32.const 288) "\ac\20\35\00")
      (data (i32.const 304) "\3d\d8\00\de\21\00")
      (data (i32.const 320) "na\efve \ff ok 123"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=latin1+utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func $desc (param $i i32) (param $p i32) (param $l i32)
        (i32.store (i32.add (i32.const 64) (i32.shl (local.get $i) (i32.const 3))) (local.get $p))
        (i32.store (i32.add (i32.const 68) (i32.shl (local.get $i) (i32.const 3))) (local.get $l)))
      (func (export "run") (result i32)
        (local $k i32)
        (call $desc (i32.const 0) (i32.const 256) (i32.const 0))
        (call $desc (i32.const 1) (i32.const 256) (i32.const 3))
        (call $desc (i32.const 2) (i32.const 272) (i32.const 4))
        (call $desc (i32.const 3) (i32.const 288) (i32.const 0x80000002))
        (call $desc (i32.const 4) (i32.const 304) (i32.const 0x80000003))
        (call $desc (i32.const 5) (i32.const 320) (i32.const 14))
        (i32.store (i32.const 512) (i32.const 64))
        (i32.store (i32.const 516) (i32.const 6))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $k) (i32.const 15)))
          (i32.store (i32.add (i32.const 520) (i32.shl (local.get $k) (i32.const 2)))
            (i32.mul (i32.add (local.get $k) (i32.const 1)) (i32.const 0x9e3779b1)))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $l)))
        (call $f (i32.const 512)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
