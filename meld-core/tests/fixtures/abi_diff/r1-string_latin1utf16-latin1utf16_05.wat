(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func $realloc (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (func $hash (param $p i32) (param $len i32) (result i32)
        (local $h i32) (local $i i32) (local $n i32)
        (local.set $h (local.get $len))
        (local.set $n (i32.and (local.get $len) (i32.const 0x7fffffff)))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (if (result i32) (i32.shr_u (local.get $len) (i32.const 31))
              (then (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1)))))
              (else (i32.load8_u (i32.add (local.get $p) (local.get $i)))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.get $h))
      ;; (ptr, tagged len) -> retptr to (ptr, tagged len); result is utf16: 3 units derived from input hash + e-acute, euro, astral char
      (func (export "uf") (param $p i32) (param $len i32) (result i32)
        (local $h i32) (local $buf i32) (local $rec i32)
        (local.set $h (call $hash (local.get $p) (local.get $len)))
        (local.set $buf (call $realloc (i32.const 0) (i32.const 0) (i32.const 2) (i32.const 14)))
        (i32.store16 (local.get $buf) (i32.add (i32.const 0x4E00) (i32.and (local.get $h) (i32.const 0xFFF))))
        (i32.store16 offset=2 (local.get $buf) (i32.add (i32.const 0x4E00) (i32.and (i32.shr_u (local.get $h) (i32.const 12)) (i32.const 0xFFF))))
        (i32.store16 offset=4 (local.get $buf) (i32.add (i32.const 0x4E00) (i32.shr_u (local.get $h) (i32.const 24))))
        (i32.store16 offset=6 (local.get $buf) (i32.const 0xE9))
        (i32.store16 offset=8 (local.get $buf) (i32.const 0x20AC))
        (i32.store16 offset=10 (local.get $buf) (i32.const 0xD83D))
        (i32.store16 offset=12 (local.get $buf) (i32.const 0xDE00))
        (local.set $rec (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
        (i32.store (local.get $rec) (local.get $buf))
        (i32.store offset=4 (local.get $rec) (i32.or (i32.const 7) (i32.const 0x80000000)))
        (local.get $rec))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "s" string) (result string)
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (param "s" string) (result string)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; utf16 "Z e-acute euro astral" at 64; latin1 "e-acute t e-acute y-diaeresis" at 96
      (data (i32.const 64) "\5a\00\e9\00\ac\20\3d\d8\00\de")
      (data (i32.const 96) "\e9\74\e9\ff"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=latin1+utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32 i32)))
      (func $hash (param $p i32) (param $len i32) (result i32)
        (local $h i32) (local $i i32) (local $n i32)
        (local.set $h (local.get $len))
        (local.set $n (i32.and (local.get $len) (i32.const 0x7fffffff)))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (if (result i32) (i32.shr_u (local.get $len) (i32.const 31))
              (then (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1)))))
              (else (i32.load8_u (i32.add (local.get $p) (local.get $i)))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.get $h))
      (func (export "run") (result i32)
        (local $h1 i32) (local $h2 i32)
        (call $f (i32.const 64) (i32.or (i32.const 5) (i32.const 0x80000000)) (i32.const 512))
        (local.set $h1 (call $hash (i32.load (i32.const 512)) (i32.load (i32.const 516))))
        (call $f (i32.const 96) (i32.const 4) (i32.const 520))
        (local.set $h2 (call $hash (i32.load (i32.const 520)) (i32.load (i32.const 524))))
        (i32.add (i32.mul (local.get $h1) (i32.const 31)) (local.get $h2)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
