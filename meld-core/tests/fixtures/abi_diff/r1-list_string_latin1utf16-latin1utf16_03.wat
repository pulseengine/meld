(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params-ptr: a@0, list(ptr,len)@4, b(u64)@16, 14 x u32 @24..80
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $lp i32) (local $n i32) (local $i i32) (local $sp i32) (local $sl i32) (local $j i32) (local $m i32) (local $x i32) (local $b i64)
        (local.set $h (i32.load (local.get $p)))
        (local.set $lp (i32.load offset=4 (local.get $p)))
        (local.set $n (i32.load offset=8 (local.get $p)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $n)))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $sp (i32.load (i32.add (local.get $lp) (i32.shl (local.get $i) (i32.const 3)))))
          (local.set $sl (i32.load offset=4 (i32.add (local.get $lp) (i32.shl (local.get $i) (i32.const 3)))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $sl)))
          (local.set $m (i32.and (local.get $sl) (i32.const 0x7fffffff)))
          (local.set $j (i32.const 0))
          (block $d2 (loop $l2
            (br_if $d2 (i32.ge_u (local.get $j) (local.get $m)))
            (if (i32.and (local.get $sl) (i32.const 0x80000000))
              (then (local.set $x (i32.load16_u (i32.add (local.get $sp) (i32.shl (local.get $j) (i32.const 1))))))
              (else (local.set $x (i32.load8_u (i32.add (local.get $sp) (local.get $j))))))
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $x)))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $l2)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.set $b (i64.load offset=16 (local.get $p)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.wrap_i64 (local.get $b))))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.wrap_i64 (i64.shr_u (local.get $b) (i64.const 32)))))
        (local.set $i (i32.const 0))
        (block $d3 (loop $l3
          (br_if $d3 (i32.ge_u (local.get $i) (i32.const 14)))
          (local.set $x (i32.load offset=24 (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 2)))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $x)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l3)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf")
      (param "a" u32) (param "l" (list string)) (param "b" u64)
      (param "c0" u32) (param "c1" u32) (param "c2" u32) (param "c3" u32) (param "c4" u32) (param "c5" u32) (param "c6" u32)
      (param "c7" u32) (param "c8" u32) (param "c9" u32) (param "c10" u32) (param "c11" u32) (param "c12" u32) (param "c13" u32)
      (result u32)
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f
      (param "a" u32) (param "l" (list string)) (param "b" u64)
      (param "c0" u32) (param "c1" u32) (param "c2" u32) (param "c3" u32) (param "c4" u32) (param "c5" u32) (param "c6" u32)
      (param "c7" u32) (param "c8" u32) (param "c9" u32) (param "c10" u32) (param "c11" u32) (param "c12" u32) (param "c13" u32)
      (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (data (i32.const 64) "caf\e9")
      (data (i32.const 80) "a\00\ac\20\3d\d8\00\de")
      (data (i32.const 112) "Zo\eb quick fox!")
      (data (i32.const 144) "\ac\20\75\00\72\00\6f\00"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=latin1+utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func (export "run") (result i32)
        (local $i i32)
        ;; list array at 192: latin1, utf16, empty, latin1, utf16
        (i32.store offset=192 (i32.const 0) (i32.const 64))
        (i32.store offset=196 (i32.const 0) (i32.const 4))
        (i32.store offset=200 (i32.const 0) (i32.const 80))
        (i32.store offset=204 (i32.const 0) (i32.const 0x80000004))
        (i32.store offset=208 (i32.const 0) (i32.const 96))
        (i32.store offset=212 (i32.const 0) (i32.const 0))
        (i32.store offset=216 (i32.const 0) (i32.const 112))
        (i32.store offset=220 (i32.const 0) (i32.const 14))
        (i32.store offset=224 (i32.const 0) (i32.const 144))
        (i32.store offset=228 (i32.const 0) (i32.const 0x80000004))
        ;; params block at 256 (align 8, size 80)
        (i32.store offset=256 (i32.const 0) (i32.const 0xA5A5))
        (i32.store offset=260 (i32.const 0) (i32.const 192))
        (i32.store offset=264 (i32.const 0) (i32.const 5))
        (i64.store offset=272 (i32.const 0) (i64.const 0x1122334455667788))
        (block $d (loop $l
          (br_if $d (i32.ge_u (local.get $i) (i32.const 14)))
          (i32.store offset=280 (i32.shl (local.get $i) (i32.const 2))
            (i32.mul (i32.add (local.get $i) (i32.const 1)) (i32.const 40503)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (call $f (i32.const 256)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
