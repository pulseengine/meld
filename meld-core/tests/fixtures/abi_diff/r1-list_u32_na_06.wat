        (local $h i32) (local $i i32) (local $ptr i32) (local $len i32) (local $v i64)
        (local.set $ptr (i32.load (local.get $p)))
        (local.set $len (i32.load offset=4 (local.get $p)))
        (local.set $h (local.get $len))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
          (local.set $v (i64.load (i32.add (local.get $ptr) (i32.shl (local.get $i) (i32.const 3)))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.wrap_i64 (local.get $v))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.wrap_i64 (i64.shr_u (local.get $v) (i64.const 32)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.set $i (i32.const 0))
        (block $d2 (loop $l2
          (br_if $d2 (i32.ge_u (local.get $i) (i32.const 16)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (i32.load (i32.add (i32.add (local.get $p) (i32.const 8)) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l2)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "a" (list f64)) (param "n0" u32) (param "n1" u32) (param "n2" u32) (param "n3" u32) (param "n4" u32) (param "n5" u32) (param "n6" u32) (param "n7" u32) (param "n8" u32) (param "n9" u32) (param "n10" u32) (param "n11" u32) (param "n12" u32) (param "n13" u32) (param "n14" u32) (param "n15" u32) (result u32)
      (canon lift (core func $m "uf")
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (param "a" (list f64)) (param "n0" u32) (param "n1" u32) (param "n2" u32) (param "n3" u32) (param "n4" u32) (param "n5" u32) (param "n6" u32) (param "n7" u32) (param "n8" u32) (param "n9" u32) (param "n10" u32) (param "n11" u32) (param "n12" u32) (param "n13" u32) (param "n14" u32) (param "n15" u32) (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
