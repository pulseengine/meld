      (data (i32.const 128) "\f0\ff\00\00\03\00\00\00\07\00\00\00\0e\00\00\00\15\00\00\00\1c\00\00\00\23\00\00\00\2a\00\00\00\31\00\00\00\38\00\00\00\3f\00\00\00\46\00\00\00\4d\00\00\00\54\00\00\00\5b\00\00\00\62\00\00\00\69\00\00\00\70\00\00\00"))
    (core instance $libc (instantiate $Libc))
