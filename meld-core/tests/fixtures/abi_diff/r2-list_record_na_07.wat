(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params-ptr: [list ptr, list len, 15 x u32]; hashes everything
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $i i32) (local $n i32) (local $b i32) (local $lp i32)
        (local.set $lp (i32.load (local.get $p)))
        (local.set $n (i32.load offset=4 (local.get $p)))
        (local.set $h (local.get $n))
        (loop $l
          (if (i32.lt_u (local.get $i) (local.get $n))
            (then
              (local.set $b (i32.add (local.get $lp) (i32.mul (local.get $i) (i32.const 12))))
              (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load8_u (local.get $b))))
              (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=4 (local.get $b))))
              (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=8 (local.get $b))))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br $l))))
        (local.set $i (i32.const 0))
        (loop $k
          (if (i32.lt_u (local.get $i) (i32.const 15))
            (then
              (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
                (i32.load offset=8 (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 2))))))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br $k))))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (type $r0 (record (field "x" u8) (field "y" u32) (field "z" char)))
    (export $r "r" (type $r0))
    (func (export "uf")
      (param "l" (list $r))
      (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32)
      (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32)
      (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32)
      (result u32)
      (canon lift (core func $m "uf")
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $rd (record (field "x" u8) (field "y" u32) (field "z" char)))
    (import "r" (type $r (eq $rd)))
    (import "uf" (func $f
      (param "l" (list $r))
      (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32)
      (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32)
      (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32)
      (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 2048))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; 5 records {u8,u32,char}, 12 bytes each; chars: U+1F600, e-acute, U+20AC, U+10FFFF, 'A'
      (data (i32.const 512)
        "\ff\00\00\00\ef\be\ad\de\00\f6\01\00"
        "\00\00\00\00\01\00\00\00\e9\00\00\00"
        "\7f\00\00\00\00\00\00\80\ac\20\00\00"
        "\01\00\00\00\78\56\34\12\ff\ff\10\00"
        "\a5\00\00\00\00\00\00\00\41\00\00\00"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f)
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func (export "run") (result i32)
        (local $i i32)
        (i32.store (i32.const 256) (i32.const 512))
        (i32.store (i32.const 260) (i32.const 5))
        (loop $l
          (if (i32.lt_u (local.get $i) (i32.const 15))
            (then
              (i32.store offset=264 (i32.shl (local.get $i) (i32.const 2))
                (i32.add (i32.mul (local.get $i) (i32.const 0x9E3779B1)) (i32.const 17)))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br $l))))
        (call $f (i32.const 256)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
