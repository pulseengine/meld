(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func $realloc (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; builds record at align 8: a@0 b@4 c@8 d@16 e@20, size 24
      (func (export "uf") (result i32)
        (local $p i32)
        (local.set $p (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 24)))
        (i32.store8 (local.get $p) (i32.const 0xC6))
        (i32.store offset=4 (local.get $p) (i32.const 0x80000001))
        (i64.store offset=8 (local.get $p) (i64.const 0x8000000012345678))
        (f32.store offset=16 (local.get $p) (f32.const -2.5))
        (i32.store8 offset=20 (local.get $p) (i32.const 1))
        (local.get $p))
    )
    (core instance $m (instantiate $M))
    (type $R0 (record (field "a" u8) (field "b" u32) (field "c" u64) (field "d" f32) (field "e" bool)))
    (export $R "r" (type $R0))
    (func (export "uf") (result $R)
      (canon lift (core func $m "uf")
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $R0 (record (field "a" u8) (field "b" u32) (field "c" u64) (field "d" f32) (field "e" bool)))
    (import "r" (type $R (eq $R0)))
    (import "uf" (func $f (result $R)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r)))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f)
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32)))
      (func $mix (param $h i32) (param $x i32) (result i32)
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $x)))
      (func (export "run") (result i32)
        (local $h i32) (local $c i64)
        (call $f (i32.const 256))
        (local.set $h (call $mix (i32.const 7) (i32.load8_u (i32.const 256))))
        (local.set $h (call $mix (local.get $h) (i32.load (i32.const 260))))
        (local.set $c (i64.load (i32.const 264)))
        (local.set $h (call $mix (local.get $h) (i32.wrap_i64 (local.get $c))))
        (local.set $h (call $mix (local.get $h) (i32.wrap_i64 (i64.shr_u (local.get $c) (i64.const 32)))))
        (local.set $h (call $mix (local.get $h) (i32.reinterpret_f32 (f32.load (i32.const 272)))))
        (local.set $h (call $mix (local.get $h) (i32.load8_u (i32.const 276))))
        (local.get $h))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "r" (type $c "r")) (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
