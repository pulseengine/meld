(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; (d1, v1, d2, v2) -> ptr to tuple<u32, option<char>> {u32 @0, disc u8 @4, char @8}
      (func (export "uf") (param $d1 i32) (param $v1 i32) (param $d2 i32) (param $v2 i32) (result i32)
        (local $h i32) (local $p i32)
        (local.set $h (local.get $d1))
        (if (local.get $d1)
          (then (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $v1)))))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $d2)))
        (if (local.get $d2)
          (then (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $v2)))))
        (local.set $p (call $realloc_self (i32.const 12)))
        (i32.store (local.get $p) (local.get $h))
        (if (local.get $d1)
          (then
            (i32.store8 (i32.add (local.get $p) (i32.const 4)) (i32.const 1))
            (i32.store (i32.add (local.get $p) (i32.const 8))
              (i32.add (i32.const 0x20AC) (i32.and (local.get $h) (i32.const 15)))))
          (else (i32.store8 (i32.add (local.get $p) (i32.const 4)) (i32.const 0))))
        (local.get $p))
      (func $realloc_self (param $n i32) (result i32)
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (global.get $next)
        (global.set $next (i32.add (global.get $next) (local.get $n))))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "a" (option u32)) (param "b" (option char)) (result (tuple u32 (option char)))
      (canon lift (core func $m "uf")
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (param "a" (option u32)) (param "b" (option char)) (result (tuple u32 (option char)))))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r)))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f)
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32 i32 i32 i32)))
      (func $fold (param $acc i32) (result i32)
        (local $t i32)
        (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 31)) (i32.load (i32.const 256))))
        (local.set $t (i32.load8_u (i32.const 260)))
        (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 31)) (local.get $t)))
        (if (local.get $t)
          (then (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 31)) (i32.load (i32.const 264))))))
        (local.get $acc))
      (func (export "run") (result i32)
        (local $acc i32)
        ;; some(0x80000001), none
        (call $f (i32.const 1) (i32.const 0x80000001) (i32.const 0) (i32.const 0) (i32.const 256))
        (local.set $acc (call $fold (i32.const 0)))
        ;; none, some('\u{E9}')
        (call $f (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 0xE9) (i32.const 256))
        (local.set $acc (call $fold (local.get $acc)))
        ;; some(7), some(U+10348)
        (call $f (i32.const 1) (i32.const 7) (i32.const 1) (i32.const 0x10348) (i32.const 256))
        (local.set $acc (call $fold (local.get $acc)))
        (local.get $acc))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
