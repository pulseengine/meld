(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 4096))
      (global $n (mut i32) (i32.const 0))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; returns pointer to (ptr, len) pair in callee memory; 1st call latin1-fitting, 2nd needs utf16
      (func (export "uf") (result i32)
        (if (i32.eqz (global.get $n))
          (then (i32.store (i32.const 512) (i32.const 2048))
                (i32.store (i32.const 516) (i32.const 15)))
          (else (i32.store (i32.const 512) (i32.const 2064))
                (i32.store (i32.const 516) (i32.const 10))))
        (global.set $n (i32.add (global.get $n) (i32.const 1)))
        (i32.const 512))
      (data (i32.const 2048) "Zo\c3\ab \c3\bf \c3\b1and\c3\ba")
      (data (i32.const 2064) "x\e2\82\ac\f0\9f\98\80\c3\a9")
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (result string)
      (canon lift (core func $m "uf") string-encoding=utf8
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (result string)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r)))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=latin1+utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32)))
      (func $hash (param $p i32) (param $len i32) (result i32)
        (local $h i32) (local $n i32) (local $i i32) (local $u i32)
        (local.set $h (local.get $len))
        (local.set $n (i32.and (local.get $len) (i32.const 0x7fffffff)))
        (block $done
          (loop $l
            (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
            (if (i32.and (local.get $len) (i32.const 0x80000000))
              (then (local.set $u (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1))))))
              (else (local.set $u (i32.load8_u (i32.add (local.get $p) (local.get $i))))))
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $u)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $l)))
        (local.get $h))
      (func (export "run") (result i32)
        (local $h i32)
        (call $f (i32.const 256))
        (local.set $h (call $hash (i32.load (i32.const 256)) (i32.load (i32.const 260))))
        (call $f (i32.const 272))
        (i32.add (i32.mul (local.get $h) (i32.const 31))
          (call $hash (i32.load (i32.const 272)) (i32.load (i32.const 276)))))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
