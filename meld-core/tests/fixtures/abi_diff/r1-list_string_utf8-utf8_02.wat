          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $sp (i32.load (i32.add (local.get $lp) (i32.mul (local.get $i) (i32.const 8)))))
          (local.set $sl (i32.load offset=4 (i32.add (local.get $lp) (i32.mul (local.get $i) (i32.const 8)))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $sl)))
          (local.set $j (i32.const 0))
