(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (func $fold (param $h i32) (param $x i32) (result i32)
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $x)))
      (func $str (param $h i32) (param $p i32) (param $n i32) (result i32)
        (local $i i32)
        (local.set $h (call $fold (local.get $h) (local.get $n)))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $h (call $fold (local.get $h)
            (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.get $h))
      ;; params-ptr layout: s@0 a@8 b@16 t@24 n0..n11@32..76
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $i i32)
        (local.set $h (call $str (i32.const 0) (i32.load (local.get $p)) (i32.load offset=4 (local.get $p))))
        (local.set $h (call $fold (local.get $h) (i32.load offset=8 (local.get $p))))
        (local.set $h (call $fold (local.get $h) (i32.wrap_i64 (i64.load offset=16 (local.get $p)))))
        (local.set $h (call $fold (local.get $h) (i32.wrap_i64 (i64.shr_u (i64.load offset=16 (local.get $p)) (i64.const 32)))))
        (local.set $h (call $str (local.get $h) (i32.load offset=24 (local.get $p)) (i32.load offset=28 (local.get $p))))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (i32.const 12)))
          (local.set $h (call $fold (local.get $h)
            (i32.load offset=32 (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf")
      (param "s" string) (param "a" u32) (param "b" u64) (param "t" string)
      (param "n0" u32) (param "n1" u32) (param "n2" u32) (param "n3" u32) (param "n4" u32) (param "n5" u32)
      (param "n6" u32) (param "n7" u32) (param "n8" u32) (param "n9" u32) (param "n10" u32) (param "n11" u32)
      (result u32)
      (canon lift (core func $m "uf") string-encoding=utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f
      (param "s" string) (param "a" u32) (param "b" u64) (param "t" string)
      (param "n0" u32) (param "n1" u32) (param "n2" u32) (param "n3" u32) (param "n4" u32) (param "n5" u32)
      (param "n6" u32) (param "n7" u32) (param "n8" u32) (param "n9" u32) (param "n10" u32) (param "n11" u32)
      (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; s = U+20AC 'a' (2 units); t = U+00E9 U+20AC U+1F600 'z' (5 units)
      (data (i32.const 64) "\ac\20\61\00")
      (data (i32.const 96) "\e9\00\ac\20\3d\d8\00\de\7a\00"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func (export "run") (result i32)
        (local $i i32)
        (i32.store (i32.const 256) (i32.const 64))
        (i32.store (i32.const 260) (i32.const 2))
        (i32.store (i32.const 264) (i32.const 0xC0FFEE01))
        (i64.store (i32.const 272) (i64.const 0x1122334455667788))
        (i32.store (i32.const 280) (i32.const 96))
        (i32.store (i32.const 284) (i32.const 5))
        (loop $l
          (i32.store offset=288 (i32.shl (local.get $i) (i32.const 2))
            (i32.add (i32.mul (i32.mul (local.get $i) (local.get $i)) (i32.const 131)) (i32.const 17)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $l (i32.lt_u (local.get $i) (i32.const 12))))
        (call $f (i32.const 256)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
