(component
  (component $C
    (type $rec0 (record (field "id" u32) (field "name" string) (field "tag" char)))
    (export $rec "rec" (type $rec0))
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params-ptr: id@0 name.ptr@4 name.len@8 tag@12 x0..x12@16..64
      (func (export "uf") (param $a i32) (result i32)
        (local $h i32) (local $p i32) (local $len i32) (local $n i32) (local $i i32)
        (local.set $h (i32.load (local.get $a)))
        (local.set $p (i32.load offset=4 (local.get $a)))
        (local.set $len (i32.load offset=8 (local.get $a)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $len)))
        (if (i32.and (local.get $len) (i32.const 0x80000000))
          (then
            (local.set $n (i32.and (local.get $len) (i32.const 0x7fffffff)))
            (block $d1 (loop $l1
              (br_if $d1 (i32.ge_u (local.get $i) (local.get $n)))
              (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
                (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1))))))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br $l1))))
          (else
            (block $d2 (loop $l2
              (br_if $d2 (i32.ge_u (local.get $i) (local.get $len)))
              (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
                (i32.load8_u (i32.add (local.get $p) (local.get $i)))))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br $l2)))))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=12 (local.get $a))))
        (local.set $i (i32.const 0))
        (block $d3 (loop $l3
          (br_if $d3 (i32.ge_u (local.get $i) (i32.const 13)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (i32.load offset=16 (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l3)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "r" $rec) (param "x0" u32) (param "x1" u32) (param "x2" u32) (param "x3" u32) (param "x4" u32) (param "x5" u32) (param "x6" u32) (param "x7" u32) (param "x8" u32) (param "x9" u32) (param "x10" u32) (param "x11" u32) (param "x12" u32) (result u32)
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $rec0 (record (field "id" u32) (field "name" string) (field "tag" char)))
    (import "rec" (type $rec (eq $rec0)))
    (import "uf" (func $f (param "r" $rec) (param "x0" u32) (param "x1" u32) (param "x2" u32) (param "x3" u32) (param "x4" u32) (param "x5" u32) (param "x6" u32) (param "x7" u32) (param "x8" u32) (param "x9" u32) (param "x10" u32) (param "x11" u32) (param "x12" u32) (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; utf16 "A" U+00E9 U+20AC U+1F600 "x" = 6 code units
      (data (i32.const 64) "\41\00\e9\00\ac\20\3d\d8\00\de\78\00"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func (export "run") (result i32)
        (local $i i32)
        (i32.store (i32.const 256) (i32.const 0x1234))
        (i32.store (i32.const 260) (i32.const 64))
        ;; MALFORMED: 40000 utf16 units = 80000 bytes from ptr 64, beyond the 64KiB memory (real data is 6 units)
        (i32.store (i32.const 264) (i32.const 40000))
        (i32.store (i32.const 268) (i32.const 0x20AC))
        (block $d (loop $l
          (br_if $d (i32.ge_u (local.get $i) (i32.const 13)))
          (i32.store (i32.add (i32.const 272) (i32.shl (local.get $i) (i32.const 2)))
            (i32.add (i32.mul (local.get $i) (local.get $i)) (i32.const 3)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (call $f (i32.const 256)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "rec" (type $c "rec")) (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
