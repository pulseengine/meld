(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; hash tagged len, every code unit (16-bit if tagged else bytes), and the char
      (func (export "uf") (param $p i32) (param $len i32) (param $c i32) (result i32)
        (local $h i32) (local $n i32) (local $i i32)
        (local.set $h (i32.add (i32.mul (i32.const 17) (i32.const 31)) (local.get $len)))
        (if (i32.and (local.get $len) (i32.const 0x80000000))
          (then
            (local.set $n (i32.and (local.get $len) (i32.const 0x7fffffff)))
            (block $done16
              (loop $l16
                (br_if $done16 (i32.ge_u (local.get $i) (local.get $n)))
                (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
                  (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1))))))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $l16))))
          (else
            (local.set $n (local.get $len))
            (block $done8
              (loop $l8
                (br_if $done8 (i32.ge_u (local.get $i) (local.get $n)))
                (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
                  (i32.load8_u (i32.add (local.get $p) (local.get $i)))))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $l8)))))
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $c)))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "s" string) (param "c" char) (result u32)
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $take (param "s" string) (param "c" char) (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; utf16 "a\u00e9\u20ac\u{1F600}" at 64 (5 units), latin1 "caf\u00e9" at 80 (4 bytes)
      (data (i32.const 64) "\61\00\e9\00\ac\20\3d\d8\00\de")
      (data (i32.const 80) "\63\61\66\e9"))
    (core instance $libc (instantiate $Libc))
    (core func $take' (canon lower (func $take) string-encoding=latin1+utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $take (param i32 i32 i32) (result i32)))
      (func (export "run") (result i32)
        (local $a i32) (local $b i32)
        (local.set $a (call $take (i32.const 64) (i32.const 0x80000005) (i32.const 0x1F600)))
        (local.set $b (call $take (i32.const 80) (i32.const 4) (i32.const 0x20AC)))
        (i32.add (i32.mul (local.get $a) (i32.const 31)) (local.get $b)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $take'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
