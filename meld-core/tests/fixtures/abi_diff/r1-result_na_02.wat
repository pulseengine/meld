(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params-ptr convention: 7 x result<char,u32> (8 bytes each) then a, b, c
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $i i32) (local $o i32)
        (block $done
          (loop $l
            (br_if $done (i32.ge_u (local.get $i) (i32.const 7)))
            (local.set $o (i32.add (local.get $p) (i32.mul (local.get $i) (i32.const 8))))
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load8_u (local.get $o))))
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=4 (local.get $o))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $l)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=56 (local.get $p))))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=60 (local.get $p))))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=64 (local.get $p))))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf")
      (param "r0" (result char (error u32)))
      (param "r1" (result char (error u32)))
      (param "r2" (result char (error u32)))
      (param "r3" (result char (error u32)))
      (param "r4" (result char (error u32)))
      (param "r5" (result char (error u32)))
      (param "r6" (result char (error u32)))
      (param "a" u32) (param "b" u32) (param "c" u32)
      (result u32)
      (canon lift (core func $m "uf")
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f
      (param "r0" (result char (error u32)))
      (param "r1" (result char (error u32)))
      (param "r2" (result char (error u32)))
      (param "r3" (result char (error u32)))
      (param "r4" (result char (error u32)))
      (param "r5" (result char (error u32)))
      (param "r6" (result char (error u32)))
      (param "a" u32) (param "b" u32) (param "c" u32)
      (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (data (i32.const 128)
        "\00\00\00\00\e9\00\00\00"
        "\01\00\00\00\04\03\02\01"
        "\00\00\00\00\ac\20\00\00"
        "\00\00\00\00\00\f6\01\00"
        "\01\00\00\00\00\00\00\00"
        "\01\00\00\00\00\00\00\80"
        "\00\00\00\00\ff\ff\10\00"
        "\e8\03\00\00\d0\07\00\00\b8\0b\00\00"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f)
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func (export "run") (result i32)
        (call $f (i32.const 128)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
