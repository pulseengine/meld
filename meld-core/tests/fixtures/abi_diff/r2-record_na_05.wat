(component
  (component $C
    (type $r0 (record (field "a" u8) (field "b" u32) (field "c" u64) (field "d" f32) (field "e" bool)))
    (export $r "r" (type $r0))
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params-ptr: record at +0 (a@0 b@4 c@8 d@16 e@20), then 12 u32 at +24
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $i i32)
        (local.set $h (i32.load8_u (local.get $p)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load (i32.add (local.get $p) (i32.const 4)))))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load (i32.add (local.get $p) (i32.const 8)))))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load (i32.add (local.get $p) (i32.const 12)))))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load (i32.add (local.get $p) (i32.const 16)))))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load8_u (i32.add (local.get $p) (i32.const 20)))))
        (loop $l
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (i32.load (i32.add (i32.add (local.get $p) (i32.const 24)) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $l (i32.lt_u (local.get $i) (i32.const 12))))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "r" $r) (param "x0" u32) (param "x1" u32) (param "x2" u32) (param "x3" u32) (param "x4" u32) (param "x5" u32) (param "x6" u32) (param "x7" u32) (param "x8" u32) (param "x9" u32) (param "x10" u32) (param "x11" u32) (result u32)
      (canon lift (core func $m "uf")
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $r0 (record (field "a" u8) (field "b" u32) (field "c" u64) (field "d" f32) (field "e" bool)))
    (import "r" (type $r (eq $r0)))
    (import "uf" (func $f (param "r" $r) (param "x0" u32) (param "x1" u32) (param "x2" u32) (param "x3" u32) (param "x4" u32) (param "x5" u32) (param "x6" u32) (param "x7" u32) (param "x8" u32) (param "x9" u32) (param "x10" u32) (param "x11" u32) (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; a=0x9c, pad, b=0xCAFEBABE, c=0x0123456789ABCDEF, d=2.5f, e=5 (invalid bool), pad, then 12 u32 (7*k)
      (data (i32.const 128) "\9c\00\00\00\be\ba\fe\ca\ef\cd\ab\89\67\45\23\01\00\00\20\40\05\00\00\00")
      (data (i32.const 152) "\07\00\00\00\0e\00\00\00\15\00\00\00\1c\00\00\00\23\00\00\00\2a\00\00\00\31\00\00\00\38\00\00\00\3f\00\00\00\46\00\00\00\4d\00\00\00\54\00\00\00"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f)
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func (export "run") (result i32)
        (call $f (i32.const 128)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "r" (type $c "r")) (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
