(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func $realloc (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (func $fold (param $h i32) (param $x i32) (result i32)
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $x)))
      ;; params ptr -> result ptr. params: id@0 name@4/8 tag@12 x0..x13@16..
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $i i32) (local $n i32) (local $sp i32) (local $rec i32)
        (local.set $h (call $fold (i32.const 7) (i32.load (local.get $p))))
        (local.set $sp (i32.load offset=4 (local.get $p)))
        (local.set $n (i32.load offset=8 (local.get $p)))
        (local.set $h (call $fold (local.get $h) (local.get $n)))
        (block $b1 (loop $l1
          (br_if $b1 (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $h (call $fold (local.get $h)
            (i32.load16_u (i32.add (local.get $sp) (i32.shl (local.get $i) (i32.const 1))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l1)))
        (local.set $h (call $fold (local.get $h) (i32.load offset=12 (local.get $p))))
        (local.set $i (i32.const 0))
        (block $b2 (loop $l2
          (br_if $b2 (i32.ge_u (local.get $i) (i32.const 14)))
          (local.set $h (call $fold (local.get $h)
            (i32.load offset=16 (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l2)))
        (local.set $rec (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 16)))
        (i32.store (local.get $rec) (local.get $h))
        (i32.store offset=4 (local.get $rec) (i32.const 512))
        (i32.store offset=8 (local.get $rec) (i32.const 5))
        (i32.store offset=12 (local.get $rec) (i32.const 0x10348))
        (local.get $rec))
      ;; utf16: Z, U+00DF, U+20AC, U+1F600 (surrogate pair)
      (data (i32.const 512) "\5a\00\df\00\ac\20\3d\d8\00\de"))
    (core instance $m (instantiate $M))
    (type $R0 (record (field "id" u32) (field "name" string) (field "tag" char)))
    (export $R "rec" (type $R0))
    (func (export "uf") (param "r" $R) (param "x0" u32) (param "x1" u32) (param "x2" u32) (param "x3" u32) (param "x4" u32) (param "x5" u32) (param "x6" u32) (param "x7" u32) (param "x8" u32) (param "x9" u32) (param "x10" u32) (param "x11" u32) (param "x12" u32) (param "x13" u32) (result $R)
      (canon lift (core func $m "uf") string-encoding=utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $R0 (record (field "id" u32) (field "name" string) (field "tag" char)))
    (import "rec" (type $R (eq $R0)))
    (import "uf" (func $f (param "r" $R) (param "x0" u32) (param "x1" u32) (param "x2" u32) (param "x3" u32) (param "x4" u32) (param "x5" u32) (param "x6" u32) (param "x7" u32) (param "x8" u32) (param "x9" u32) (param "x10" u32) (param "x11" u32) (param "x12" u32) (param "x13" u32) (result $R)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; utf8: a, U+00E9, U+20AC, U+1F600, z (11 bytes)
      (data (i32.const 64) "a\c3\a9\e2\82\ac\f0\9f\98\80z"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=utf8
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32)))
      (func $fold (param $h i32) (param $x i32) (result i32)
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $x)))
      (func (export "run") (result i32)
        (local $i i32) (local $h i32) (local $n i32) (local $sp i32)
        (i32.store (i32.const 128) (i32.const 0xCAFE))
        (i32.store (i32.const 132) (i32.const 64))
        (i32.store (i32.const 136) (i32.const 11))
        (i32.store (i32.const 140) (i32.const 0x1F680))
        (block $b0 (loop $l0
          (br_if $b0 (i32.ge_u (local.get $i) (i32.const 14)))
          (i32.store (i32.add (i32.const 144) (i32.shl (local.get $i) (i32.const 2)))
            (i32.mul (i32.add (local.get $i) (i32.const 1)) (i32.const 0x101)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l0)))
        (call $f (i32.const 128) (i32.const 256))
        (local.set $h (i32.load (i32.const 256)))
        (local.set $sp (i32.load (i32.const 260)))
        (local.set $n (i32.load (i32.const 264)))
        (local.set $h (call $fold (local.get $h) (local.get $n)))
        (local.set $i (i32.const 0))
        (block $b1 (loop $l1
          (br_if $b1 (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $h (call $fold (local.get $h)
            (i32.load8_u (i32.add (local.get $sp) (local.get $i)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l1)))
        (call $fold (local.get $h) (i32.load (i32.const 268))))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "rec" (type $c "rec")) (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
