(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func $realloc (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; sel -> ptr to result<char,u32>: disc u8 at +0, payload at +4
      (func (export "uf") (param $sel i32) (result i32)
        (local $p i32)
        (local.set $p (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.const 8)))
        (if (i32.eq (local.get $sel) (i32.const 1))
          (then
            (i32.store8 (local.get $p) (i32.const 1))
            (i32.store offset=4 (local.get $p) (i32.const 0x80000001)))
          (else
            (i32.store8 (local.get $p) (i32.const 0))
            (i32.store offset=4 (local.get $p)
              (select (i32.const 0x1F600) (i32.const 0x10FFFF) (i32.eqz (local.get $sel))))))
        (local.get $p))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "sel" u32) (result (result char (error u32)))
      (canon lift (core func $m "uf")
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (param "sel" u32) (result (result char (error u32)))))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r)))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f)
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32)))
      (func $fold (param $h i32) (param $ptr i32) (result i32)
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load8_u (local.get $ptr))))
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=4 (local.get $ptr))))
      (func (export "run") (result i32)
        (local $h i32)
        (call $f (i32.const 0) (i32.const 256))
        (local.set $h (call $fold (local.get $h) (i32.const 256)))
        (call $f (i32.const 1) (i32.const 272))
        (local.set $h (call $fold (local.get $h) (i32.const 272)))
        (call $f (i32.const 2) (i32.const 288))
        (local.set $h (call $fold (local.get $h) (i32.const 288)))
        (local.get $h))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
