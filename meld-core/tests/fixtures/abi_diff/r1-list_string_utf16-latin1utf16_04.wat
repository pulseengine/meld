(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params-ptr: {list ptr, list len, 15 x u32}; hashes everything
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $lp i32) (local $n i32) (local $i i32)
        (local $sp i32) (local $sl i32) (local $k i32) (local $u i32)
        (local.set $lp (i32.load (local.get $p)))
        (local.set $n (i32.load offset=4 (local.get $p)))
        (local.set $h (local.get $n))
        (block $done (loop $el
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $sp (i32.load (local.get $lp)))
          (local.set $sl (i32.load offset=4 (local.get $lp)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $sl)))
          (local.set $u (i32.and (local.get $sl) (i32.const 0x7fffffff)))
          (local.set $k (i32.const 0))
          (block $sd (loop $ch
            (br_if $sd (i32.ge_u (local.get $k) (local.get $u)))
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
              (if (result i32) (i32.lt_s (local.get $sl) (i32.const 0))
                (then (i32.load16_u (i32.add (local.get $sp) (i32.shl (local.get $k) (i32.const 1)))))
                (else (i32.load8_u (i32.add (local.get $sp) (local.get $k)))))))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $ch)))
          (local.set $lp (i32.add (local.get $lp) (i32.const 8)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $el)))
        (local.set $k (i32.const 0))
        (block $ud (loop $ul
          (br_if $ud (i32.ge_u (local.get $k) (i32.const 15)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (i32.load offset=8 (i32.add (local.get $p) (i32.shl (local.get $k) (i32.const 2))))))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $ul)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "xs" (list string)) (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32) (result u32)
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (param "xs" (list string)) (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32) (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; utf16: "é" at 64, "a€𝄞" at 96
      (data (i32.const 64) "\e9\00")
      (data (i32.const 96) "\61\00\ac\20\34\d8\1e\dd"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func (export "run") (result i32)
        (local $j i32)
        ;; list<string> array at 128: ["é", "", OUT-OF-BOUNDS, "a€𝄞"]
        (i32.store (i32.const 128) (i32.const 64)) (i32.store (i32.const 132) (i32.const 1))
        (i32.store (i32.const 136) (i32.const 80)) (i32.store (i32.const 140) (i32.const 0))
        (i32.store (i32.const 144) (i32.const 0xFFF0)) (i32.store (i32.const 148) (i32.const 16))
        (i32.store (i32.const 152) (i32.const 96)) (i32.store (i32.const 156) (i32.const 4))
        ;; params tuple at 256: list ptr, len, then 15 u32s
        (i32.store (i32.const 256) (i32.const 128)) (i32.store (i32.const 260) (i32.const 4))
        (block $d (loop $l
          (br_if $d (i32.ge_u (local.get $j) (i32.const 15)))
          (i32.store offset=264 (i32.shl (local.get $j) (i32.const 2))
            (i32.add (i32.mul (local.get $j) (i32.const 7)) (i32.const 3)))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (br $l)))
        (call $f (i32.const 256)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
