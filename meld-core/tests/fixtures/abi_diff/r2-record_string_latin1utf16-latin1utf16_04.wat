(component
  (component $C
    (type $rt (record (field "id" u32) (field "name" string) (field "tag" char)))
    (export $r "r" (type $rt))
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 4096))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (func $fold (param $h i32) (param $p i32) (param $len i32) (result i32)
        (local $i i32) (local $n i32) (local $u i32)
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $len)))
        (local.set $n (i32.and (local.get $len) (i32.const 0x7fffffff)))
        (block $done
          (loop $l
            (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
            (if (i32.lt_s (local.get $len) (i32.const 0))
              (then (local.set $u (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1))))))
              (else (local.set $u (i32.load8_u (i32.add (local.get $p) (local.get $i))))))
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $u)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $l)))
        (local.get $h))
      (func (export "uf") (param $id i32) (param $p i32) (param $len i32) (param $tag i32) (result i32)
        (local $h i32)
        (local.set $h (call $fold (local.get $id) (local.get $p) (local.get $len)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $tag)))
        (i32.store (i32.const 256) (local.get $h))
        (i32.store (i32.const 260) (i32.const 2048))
        (i32.store (i32.const 264) (i32.const 8))
        (i32.store (i32.const 268) (i32.const 0x1F9EA))
        (i32.const 256))
      (data (i32.const 2048) "Zo\eb caf\e9"))
    (core instance $m (instantiate $M))
    (func (export "uf") (param "r" $r) (result $r)
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $rt (record (field "id" u32) (field "name" string) (field "tag" char)))
    (import "r" (type $r (eq $rt)))
    (import "uf" (func $f (param "r" $r) (result $r)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 4096))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (data (i32.const 64) "\e9\00\ac\20\3d\d8\00\de\7a\00"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=latin1+utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32 i32 i32 i32)))
      (func $fold (param $h i32) (param $p i32) (param $len i32) (result i32)
        (local $i i32) (local $n i32) (local $u i32)
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $len)))
        (local.set $n (i32.and (local.get $len) (i32.const 0x7fffffff)))
        (block $done
          (loop $l
            (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
            (if (i32.lt_s (local.get $len) (i32.const 0))
              (then (local.set $u (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1))))))
              (else (local.set $u (i32.load8_u (i32.add (local.get $p) (local.get $i))))))
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $u)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $l)))
        (local.get $h))
      (func (export "run") (result i32)
        (local $h i32)
        (call $f (i32.const 77777) (i32.const 64) (i32.const 0x80000005) (i32.const 0x1F680) (i32.const 512))
        (local.set $h (i32.load (i32.const 512)))
        (local.set $h (call $fold (local.get $h) (i32.load (i32.const 516)) (i32.load (i32.const 520))))
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load (i32.const 524))))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "r" (type $c "r")) (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
