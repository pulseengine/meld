(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 4096))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (data (i32.const 2048) "caf\e9")
      (data (i32.const 2056) "\ac\20u\00r\00o\00")
      (data (i32.const 2064) "\3d\d8\00\de\78\00")
      (data (i32.const 2080) "hello w\f6rld!")
      (func (export "uf") (result i32)
        (i32.store (i32.const 2112) (i32.const 2000))
        (i32.store (i32.const 2116) (i32.const 0))
        (i32.store (i32.const 2120) (i32.const 2048))
        (i32.store (i32.const 2124) (i32.const 4))
        (i32.store (i32.const 2128) (i32.const 2056))
        (i32.store (i32.const 2132) (i32.const 0x80000004))
        (i32.store (i32.const 2136) (i32.const 2064))
        (i32.store (i32.const 2140) (i32.const 0x80000003))
        (i32.store (i32.const 2144) (i32.const 2080))
        (i32.store (i32.const 2148) (i32.const 12))
        (i32.store (i32.const 2160) (i32.const 2112))
        (i32.store (i32.const 2164) (i32.const 5))
        (i32.const 2160))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (result (list string))
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (result (list string))))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r)))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=latin1+utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32)))
      (func (export "run") (result i32)
        (local $h i32) (local $p i32) (local $n i32) (local $i i32)
        (local $sp i32) (local $sl i32) (local $k i32) (local $m i32)
        (call $f (i32.const 512))
        (local.set $p (i32.load (i32.const 512)))
        (local.set $n (i32.load (i32.const 516)))
        (local.set $h (local.get $n))
        (block $done (loop $outer
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $sp (i32.load (i32.add (local.get $p) (i32.mul (local.get $i) (i32.const 8)))))
          (local.set $sl (i32.load (i32.add (local.get $p) (i32.add (i32.mul (local.get $i) (i32.const 8)) (i32.const 4)))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $sl)))
          (local.set $k (i32.const 0))
          (if (i32.and (local.get $sl) (i32.const 0x80000000))
            (then
              (local.set $m (i32.and (local.get $sl) (i32.const 0x7fffffff)))
              (block $b1 (loop $l1
                (br_if $b1 (i32.ge_u (local.get $k) (local.get $m)))
                (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
                  (i32.load16_u (i32.add (local.get $sp) (i32.mul (local.get $k) (i32.const 2))))))
                (local.set $k (i32.add (local.get $k) (i32.const 1)))
                (br $l1))))
            (else
              (local.set $m (local.get $sl))
              (block $b2 (loop $l2
                (br_if $b2 (i32.ge_u (local.get $k) (local.get $m)))
                (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
                  (i32.load8_u (i32.add (local.get $sp) (local.get $k)))))
                (local.set $k (i32.add (local.get $k) (i32.const 1)))
                (br $l2)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $outer)))
        (local.get $h))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
