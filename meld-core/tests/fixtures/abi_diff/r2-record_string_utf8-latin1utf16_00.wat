    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32 i32 i32 i32)))
      (func (export "run") (result i32)
        (local $h i32) (local $n i32) (local $p i32) (local $i i32)
        (call $f (i32.const 0x1234) (i32.const 64) (i32.const 11) (i32.const 0x2603) (i32.const 512))
        (local.set $p (i32.load (i32.const 516)))
        (local.set $n (i32.load (i32.const 520)))
        (local.set $h (i32.add (i32.mul (i32.load (i32.const 512)) (i32.const 31)) (local.get $n)))
        (block $done
