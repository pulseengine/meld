      (func (export "uf") (param $id i32) (param $p i32) (param $tl i32) (param $c i32) (result i32)
        (local $h i32) (local $n i32) (local $i i32) (local $wide i32)
        (local.set $h (i32.add (i32.mul (local.get $id) (i32.const 31)) (local.get $tl)))
        (local.set $wide (i32.and (local.get $tl) (i32.const 0x80000000)))
        (local.set $n (i32.and (local.get $tl) (i32.const 0x7fffffff)))
        (block $done
          (loop $l
            (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
            (local.set $h (i32.mul (local.get $h) (i32.const 31)))
            (if (local.get $wide)
              (then (local.set $h (i32.add (local.get $h) (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1)))))))
              (else (local.set $h (i32.add (local.get $h) (i32.load8_u (i32.add (local.get $p) (local.get $i)))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $l)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $c)))
        (i32.store (i32.const 256) (local.get $h))
        (i32.store (i32.const 260) (i32.const 128))
        (i32.store (i32.const 264) (i32.const 5))
        (i32.store (i32.const 268) (i32.const 0x1F600))
        (i32.const 256))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "r" $r) (result $r)
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $rd (record (field "id" u32) (field "name" string) (field "tag" char)))
    (import "r" (type $r (eq $rd)))
    (import "uf" (func $f (param "r" $r) (result $r)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
