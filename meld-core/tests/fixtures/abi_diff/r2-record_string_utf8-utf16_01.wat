(component
  (component $C
    (type $rec0 (record (field "id" u32) (field "name" string) (field "tag" char)))
    (export $rec "rec" (type $rec0))
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (func $mix (param $h i32) (param $x i32) (result i32)
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $x)))
      ;; params-ptr: id@0, name ptr@4, name utf16 units@8, tag@12, a0..a12 @16..64
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $i i32) (local $n i32) (local $s i32)
        (local.set $h (call $mix (i32.const 7) (i32.load (local.get $p))))
        (local.set $s (i32.load offset=4 (local.get $p)))
        (local.set $n (i32.load offset=8 (local.get $p)))
        (local.set $h (call $mix (local.get $h) (local.get $n)))
        (block $b1 (loop $l1
          (br_if $b1 (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $h (call $mix (local.get $h)
            (i32.load16_u (i32.add (local.get $s) (i32.shl (local.get $i) (i32.const 1))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l1)))
        (local.set $h (call $mix (local.get $h) (i32.load offset=12 (local.get $p))))
        (local.set $i (i32.const 0))
        (block $b2 (loop $l2
          (br_if $b2 (i32.ge_u (local.get $i) (i32.const 13)))
          (local.set $h (call $mix (local.get $h)
            (i32.load offset=16 (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l2)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "r" $rec) (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (result u32)
      (canon lift (core func $m "uf") string-encoding=utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $r0 (record (field "id" u32) (field "name" string) (field "tag" char)))
    (import "rec" (type $rec (eq $r0)))
    (import "uf" (func $f (param "r" $rec) (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; utf8: a, e-acute, euro, U+1D11E, z = 11 bytes
      (data (i32.const 64) "\61\c3\a9\e2\82\ac\f0\9d\84\9e\7a"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=utf8
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func (export "run") (result i32)
        (local $i i32)
        (i32.store (i32.const 128) (i32.const 0xC0FFEE))
        (i32.store (i32.const 132) (i32.const 64))
        (i32.store (i32.const 136) (i32.const 11))
        (i32.store (i32.const 140) (i32.const 0x1F980))
        (block $b (loop $l
          (br_if $b (i32.ge_u (local.get $i) (i32.const 13)))
          (i32.store offset=144 (i32.shl (local.get $i) (i32.const 2))
            (i32.add (i32.mul (i32.mul (local.get $i) (local.get $i)) (i32.const 977)) (i32.const 13)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (call $f (i32.const 128)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "rec" (type $c "rec")) (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
