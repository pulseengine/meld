(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (func $mix (param $h i32) (param $x i32) (result i32)
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $x)))
      ;; three result<char,u32> values flattened as (disc, payload) each; hash all six
      (func (export "uf") (param $d1 i32) (param $p1 i32) (param $d2 i32) (param $p2 i32) (param $d3 i32) (param $p3 i32) (result i32)
        (local $h i32)
        (local.set $h (i32.const 7))
        (local.set $h (call $mix (local.get $h) (local.get $d1)))
        (local.set $h (call $mix (local.get $h) (local.get $p1)))
        (local.set $h (call $mix (local.get $h) (local.get $d2)))
        (local.set $h (call $mix (local.get $h) (local.get $p2)))
        (local.set $h (call $mix (local.get $h) (local.get $d3)))
        (local.set $h (call $mix (local.get $h) (local.get $p3)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf")
      (param "a" (result char (error u32)))
      (param "b" (result char (error u32)))
      (param "c" (result char (error u32)))
      (result u32)
      (canon lift (core func $m "uf")
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f
      (param "a" (result char (error u32)))
      (param "b" (result char (error u32)))
      (param "c" (result char (error u32)))
      (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r)))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f)
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32 i32 i32 i32 i32) (result i32)))
      (func (export "run") (result i32)
        ;; a = ok(U+1F600), b = err(0x80000001), c = ok('é')
        (call $f
          (i32.const 0) (i32.const 0x1F600)
          (i32.const 1) (i32.const 0x80000001)
          (i32.const 0) (i32.const 0xE9)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
