(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; (id, ptr, byte len, char) -> hash over id, len, every utf8 byte, char
      (func (export "uf") (param $id i32) (param $p i32) (param $len i32) (param $c i32) (result i32)
        (local $h i32) (local $i i32)
        (local.set $h (i32.const 17))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $id)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $len)))
        (block $done
          (loop $l
            (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
              (i32.load8_u (i32.add (local.get $p) (local.get $i)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $l)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $c)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (type $R0 (record (field "id" u32) (field "name" string) (field "tag" char)))
    (export $R "r" (type $R0))
    (func (export "uf") (param "r" $R) (result u32)
      (canon lift (core func $m "uf") string-encoding=utf8
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $R0 (record (field "id" u32) (field "name" string) (field "tag" char)))
    (import "r" (type $R (eq $R0)))
    (import "uf" (func $f (param "r" $R) (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; utf16le: a, e-acute, euro, U+1F600 (surrogates D83D DE00), z = 6 code units
      (data (i32.const 64) "ab"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=utf8
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32 i32 i32) (result i32)))
      (func (export "run") (result i32)
        (call $f (i32.const 0xC0FFEE) (i32.const 64) (i32.const 2) (i32.const 0x1F680)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "r" (type $c "r")) (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
