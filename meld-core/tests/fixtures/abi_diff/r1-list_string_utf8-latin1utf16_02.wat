(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params block: [list ptr, list len, 15 x u32]; hashes tagged lens, code units, and the u32s
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $i i32) (local $n i32) (local $arr i32) (local $sp i32) (local $len i32) (local $j i32) (local $cnt i32)
        (local.set $h (i32.const 17))
        (local.set $arr (i32.load (local.get $p)))
        (local.set $n (i32.load offset=4 (local.get $p)))
        (block $done (loop $outer
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $sp (i32.load (i32.add (local.get $arr) (i32.shl (local.get $i) (i32.const 3)))))
          (local.set $len (i32.load offset=4 (i32.add (local.get $arr) (i32.shl (local.get $i) (i32.const 3)))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $len)))
          (local.set $j (i32.const 0))
          (if (i32.and (local.get $len) (i32.const 0x80000000))
            (then
              (local.set $cnt (i32.and (local.get $len) (i32.const 0x7fffffff)))
              (block $d1 (loop $l1
                (br_if $d1 (i32.ge_u (local.get $j) (local.get $cnt)))
                (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load16_u (i32.add (local.get $sp) (i32.shl (local.get $j) (i32.const 1))))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $l1))))
            (else
              (block $d2 (loop $l2
                (br_if $d2 (i32.ge_u (local.get $j) (local.get $len)))
                (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load8_u (i32.add (local.get $sp) (local.get $j)))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $l2)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $outer)))
        (local.set $j (i32.const 0))
        (block $d3 (loop $l3
          (br_if $d3 (i32.ge_u (local.get $j) (i32.const 15)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=8 (i32.add (local.get $p) (i32.shl (local.get $j) (i32.const 2))))))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (br $l3)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "xs" (list string)) (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32) (result u32)
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (param "xs" (list string)) (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32) (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; list array at 128: (256,0) (256,5) (261,6) (267,6) (273,12)
      (data (i32.const 128) "\00\01\00\00\00\00\00\00" "\00\01\00\00\05\00\00\00" "\05\01\00\00\06\00\00\00" "\0b\01\00\00\06\00\00\00" "\11\01\00\00\0c\00\00\00")
      ;; strings at 256: "", "café", "€uro", "a😀b", "ÿ-latin1 ok" (utf8)
      (data (i32.const 256) "caf\c3\a9" "\e2\82\acuro" "a\f0\9f\98\80b" "\c3\bf-latin1 ok"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=utf8
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func (export "run") (result i32)
        (local $i i32)
        (i32.store (i32.const 0) (i32.const 128))
        (i32.store (i32.const 4) (i32.const 5))
        (loop $l
          (i32.store (i32.add (i32.const 8) (i32.shl (local.get $i) (i32.const 2)))
            (i32.add (i32.mul (local.get $i) (i32.const 7)) (i32.const 3)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $l (i32.lt_u (local.get $i) (i32.const 15))))
        (call $f (i32.const 0)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
