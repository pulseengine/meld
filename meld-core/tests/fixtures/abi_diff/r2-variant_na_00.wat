(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params ptr -> hash of variant + 16 u32s; returns ptr to result variant c(hash)
      (func (export "uf") (param $p i32) (result i32)
        (local $h i64) (local $q i64) (local $i i32) (local $d i32) (local $r i32)
        (local.set $d (i32.load8_u (local.get $p)))
        (if (i32.eq (local.get $d) (i32.const 1))
          (then (local.set $q (i64.load8_u (i32.add (local.get $p) (i32.const 8))))))
        (if (i32.eq (local.get $d) (i32.const 2))
          (then (local.set $q (i64.load (i32.add (local.get $p) (i32.const 8))))))
        (if (i32.eq (local.get $d) (i32.const 3))
          (then (local.set $q (i64.load32_u (i32.add (local.get $p) (i32.const 8))))))
        (local.set $h (i64.add (i64.mul (i64.extend_i32_u (local.get $d)) (i64.const 31)) (local.get $q)))
        (loop $l
          (local.set $h (i64.add (i64.mul (local.get $h) (i64.const 31))
            (i64.load32_u (i32.add (local.get $p) (i32.add (i32.const 16) (i32.shl (local.get $i) (i32.const 2)))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $l (i32.lt_u (local.get $i) (i32.const 16))))
        (local.set $r (call 0 (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 16)))
        (i32.store8 (local.get $r) (i32.const 2))
        (i64.store (i32.add (local.get $r) (i32.const 8)) (local.get $h))
        (local.get $r))
    )
    (core instance $m (instantiate $M))
    (type $v0 (variant (case "a") (case "b" u8) (case "c" u64) (case "d" char)))
    (export $v "v" (type $v0))
    (func (export "uf") (param "v" $v) (param "x0" u32) (param "x1" u32) (param "x2" u32) (param "x3" u32) (param "x4" u32) (param "x5" u32) (param "x6" u32) (param "x7" u32) (param "x8" u32) (param "x9" u32) (param "x10" u32) (param "x11" u32) (param "x12" u32) (param "x13" u32) (param "x14" u32) (param "x15" u32) (result $v)
      (canon lift (core func $m "uf")
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $v0 (variant (case "a") (case "b" u8) (case "c" u64) (case "d" char)))
    (import "v" (type $v (eq $v0)))
    (import "uf" (func $f (param "v" $v) (param "x0" u32) (param "x1" u32) (param "x2" u32) (param "x3" u32) (param "x4" u32) (param "x5" u32) (param "x6" u32) (param "x7" u32) (param "x8" u32) (param "x9" u32) (param "x10" u32) (param "x11" u32) (param "x12" u32) (param "x13" u32) (param "x14" u32) (param "x15" u32) (result $v)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 2048))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (local.get $r)))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f)
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32)))
      (func (export "run") (result i32)
        (local $i i32) (local $d i32) (local $h i64)
        ;; params tuple at 128: variant c(u64) at 0..16, then 16 u32 at 16..80
        (i32.store8 (i32.const 128) (i32.const 2))
        (i64.store (i32.const 136) (i64.const 0x1122334455667788))
        (loop $l
          (i32.store (i32.add (i32.const 144) (i32.shl (local.get $i) (i32.const 2)))
            (i32.add (i32.mul (i32.mul (local.get $i) (local.get $i)) (i32.const 0x101)) (i32.const 1)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $l (i32.lt_u (local.get $i) (i32.const 16))))
        (call $f (i32.const 128) (i32.const 512))
        (local.set $d (i32.load8_u (i32.const 512)))
        (local.set $h (i64.mul (i64.extend_i32_u (local.get $d)) (i64.const 31)))
        (if (i32.eq (local.get $d) (i32.const 1))
          (then (local.set $h (i64.add (local.get $h) (i64.load8_u (i32.const 520))))))
        (if (i32.eq (local.get $d) (i32.const 2))
          (then (local.set $h (i64.add (local.get $h) (i64.load (i32.const 520))))))
        (if (i32.eq (local.get $d) (i32.const 3))
          (then (local.set $h (i64.add (local.get $h) (i64.load32_u (i32.const 520))))))
        (i32.xor (i32.wrap_i64 (local.get $h)) (i32.wrap_i64 (i64.shr_u (local.get $h) (i64.const 32)))))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (alias export $c "v" (type $ct))
  (instance $d (instantiate $D (with "v" (type $ct)) (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
