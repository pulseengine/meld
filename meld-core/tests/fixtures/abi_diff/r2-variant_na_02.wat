        (local.set $r (call $ra (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 16)))
        (i32.store8 (local.get $r) (i32.const 2))
        (i64.store offset=8 (local.get $r) (i64.const 0xFEDCBA9876543210))
        (local.get $r))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (result $v)
      (canon lift (core func $m "uf")
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $v0 (variant (case "a") (case "b" u8) (case "c" u64) (case "d" char)))
    (import "v" (type $v (eq $v0)))
    (import "uf" (func $f (result $v)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (data (i32.const 256) "\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f)
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32)))
      (func (export "run") (result i32)
        (local $h i32) (local $d i32)
        (call $f (i32.const 256))
        (local.set $d (i32.load8_u (i32.const 256)))
        (local.set $h (local.get $d))
        (if (i32.eq (local.get $d) (i32.const 1))
          (then (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load8_u (i32.const 264))))))
        (if (i32.eq (local.get $d) (i32.const 2))
          (then
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load (i32.const 264))))
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load (i32.const 268))))))
        (if (i32.eq (local.get $d) (i32.const 3))
          (then (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load (i32.const 264))))))
        (local.get $h))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
