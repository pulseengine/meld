;; list<string> result flow, latin1+utf16 on both sides: callee returns 5 strings (empty, latin1, utf16, longer latin1, utf16-tagged latin1-range)
(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (data (i32.const 2056) "caf\e9")
      (data (i32.const 2064) "\ac\20\34\d8\1e\dd\78\00")
      (data (i32.const 2096) "na\efve \fcber \f1")
      (data (i32.const 2112) "A\00\e9\00")
      (func (export "uf") (result i32)
        (i32.store (i32.const 1536) (i32.const 2048))
        (i32.store (i32.const 1540) (i32.const 0))
        (i32.store (i32.const 1544) (i32.const 2056))
        (i32.store (i32.const 1548) (i32.const 4))
        (i32.store (i32.const 1552) (i32.const 2064))
        (i32.store (i32.const 1556) (i32.const 0x80000004))
        (i32.store (i32.const 1560) (i32.const 2096))
        (i32.store (i32.const 1564) (i32.const 12))
        (i32.store (i32.const 1568) (i32.const 2112))
        (i32.store (i32.const 1572) (i32.const 0x80000002))
        (i32.store (i32.const 1600) (i32.const 1536))
        (i32.store (i32.const 1604) (i32.const 5))
        (i32.const 1600))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (result (list string))
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (result (list string))))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 4096))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r)))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=latin1+utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32)))
      (func (export "run") (result i32)
        (local $h i32) (local $ptr i32) (local $n i32) (local $i i32) (local $e i32)
        (local $sp i32) (local $tl i32) (local $len i32) (local $j i32) (local $x i32)
        (call $f (i32.const 512))
        (local.set $ptr (i32.load (i32.const 512)))
        (local.set $n (i32.load (i32.const 516)))
        (local.set $h (local.get $n))
        (loop $L
          (if (i32.lt_u (local.get $i) (local.get $n))
            (then
              (local.set $e (i32.add (local.get $ptr) (i32.shl (local.get $i) (i32.const 3))))
              (local.set $sp (i32.load (local.get $e)))
              (local.set $tl (i32.load offset=4 (local.get $e)))
              (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $tl)))
              (local.set $len (i32.and (local.get $tl) (i32.const 0x7fffffff)))
              (local.set $j (i32.const 0))
              (block $done
                (loop $K
                  (br_if $done (i32.ge_u (local.get $j) (local.get $len)))
                  (if (i32.and (local.get $tl) (i32.const 0x80000000))
                    (then (local.set $x (i32.load16_u (i32.add (local.get $sp) (i32.shl (local.get $j) (i32.const 1))))))
                    (else (local.set $x (i32.load8_u (i32.add (local.get $sp) (local.get $j))))))
                  (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $x)))
                  (local.set $j (i32.add (local.get $j) (i32.const 1)))
                  (br $K)))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br $L))))
        (local.get $h))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
