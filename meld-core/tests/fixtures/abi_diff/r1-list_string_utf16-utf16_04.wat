(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params ptr -> hash of list<string> (utf16 units) and 15 trailing u32s
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $i i32) (local $lp i32) (local $n i32) (local $sp i32) (local $sl i32) (local $j i32)
        (local.set $lp (i32.load (local.get $p)))
        (local.set $n (i32.load offset=4 (local.get $p)))
        (local.set $h (local.get $n))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $sp (i32.load (i32.add (local.get $lp) (i32.shl (local.get $i) (i32.const 3)))))
          (local.set $sl (i32.load offset=4 (i32.add (local.get $lp) (i32.shl (local.get $i) (i32.const 3)))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $sl)))
          (local.set $j (i32.const 0))
          (block $sd (loop $c
            (br_if $sd (i32.ge_u (local.get $j) (local.get $sl)))
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
              (i32.load16_u (i32.add (local.get $sp) (i32.shl (local.get $j) (i32.const 1))))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $c)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.set $i (i32.const 0))
        (block $fd (loop $m
          (br_if $fd (i32.ge_u (local.get $i) (i32.const 15)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (i32.load offset=8 (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $m)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "l" (list string)) (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32) (result u32)
      (canon lift (core func $m "uf") string-encoding=utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (param "l" (list string)) (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32) (result u32)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params tuple at 256: list(ptr=512,len=4) then a0..a14
      (data (i32.const 256) "\00\02\00\00\04\00\00\00" "\03\00\00\00" "\0a\00\00\00" "\11\00\00\00" "\18\00\00\00" "\1f\00\00\00" "\26\00\00\00" "\2d\00\00\00" "\34\00\00\00" "\3b\00\00\00" "\42\00\00\00" "\49\00\00\00" "\50\00\00\00" "\57\00\00\00" "\5e\00\00\00" "\ff\ff\ff\ff")
      ;; list elements (ptr,len): 640/2, 680/0, 648/4, 664/6
      (data (i32.const 512) "\80\02\00\00\02\00\00\00" "\a8\02\00\00\00\00\00\00" "\88\02\00\00\04\00\00\00" "\98\02\00\00\06\00\00\00")
      (data (i32.const 640) "\e9\00\ac\20")
      (data (i32.const 648) "\61\00\3d\d8\00\de\7a\00")
      (data (i32.const 664) "\f1\00\61\00\6e\00\64\00\fa\00\ac\20"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func (export "run") (result i32)
        (call $f (i32.const 256)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
