(component
  (component $C
    (type $r0 (record (field "x" u8) (field "y" u32) (field "z" char)))
    (export $r "r" (type $r0))
    (type $l0 (list $r))
    (export $l "l" (type $l0))
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 4096))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; hashes the incoming list, returns a 2-element list built in own memory
      (func (export "uf") (param $p i32) (param $n i32) (result i32)
        (local $i i32) (local $h i32) (local $e i32)
        (local.set $h (local.get $n))
        (block $done (loop $lp
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $e (i32.add (local.get $p) (i32.mul (local.get $i) (i32.const 12))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load8_u (local.get $e))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=4 (local.get $e))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=8 (local.get $e))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $lp)))
        (i32.store8 (i32.const 2048) (local.get $h))
        (i32.store (i32.const 2052) (local.get $h))
        (i32.store (i32.const 2056) (i32.const 0x20AC))
        (i32.store8 (i32.const 2060) (i32.const 0xAB))
        (i32.store (i32.const 2064) (local.get $n))
        (i32.store (i32.const 2068) (i32.const 0x1F600))
        (i32.store (i32.const 2000) (i32.const 2048))
        (i32.store (i32.const 2004) (i32.const 2))
        (i32.const 2000))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (param "l" $l) (result $l)
      (canon lift (core func $m "uf")
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $rd (record (field "x" u8) (field "y" u32) (field "z" char)))
    (import "r" (type $r (eq $rd)))
    (type $ld (list $r))
    (import "l" (type $l (eq $ld)))
    (import "uf" (func $f (param "l" $l) (result $l)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 4096))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; 3 elements of {x u8, y u32, z char}; element 1 has surrogate U+D800
      (data (i32.const 64)
        "\01\00\00\00\44\33\22\11\e9\00\00\00"
        "\ff\00\00\00\07\00\00\00\00\d8\00\00"
        "\03\00\00\00\ef\be\ad\de\48\03\01\00"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f)
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32 i32)))
      (func (export "run") (result i32)
        (local $p i32) (local $n i32) (local $i i32) (local $h i32) (local $e i32)
        (call $f (i32.const 64) (i32.const 3) (i32.const 512))
        (local.set $p (i32.load (i32.const 512)))
        (local.set $n (i32.load (i32.const 516)))
        (local.set $h (i32.add (i32.const 17) (local.get $n)))
        (block $done (loop $lp
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $e (i32.add (local.get $p) (i32.mul (local.get $i) (i32.const 12))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load8_u (local.get $e))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=4 (local.get $e))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load offset=8 (local.get $e))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $lp)))
        (local.get $h))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "r" (type $c "r")) (with "l" (type $c "l")) (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
