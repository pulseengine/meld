(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (func $mix (param $h i32) (param $x i32) (result i32)
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $x)))
      ;; params-ptr: [sptr, slen, a0..a14 u32]; returns retptr to (ptr,len) with len out of bounds
      (func (export "uf") (param $p i32) (result i32)
        (local $sp i32) (local $n i32) (local $i i32) (local $h i32) (local $wide i32)
        (local.set $sp (i32.load (local.get $p)))
        (local.set $n (i32.load offset=4 (local.get $p)))
        (local.set $h (local.get $n))
        (local.set $wide (i32.shr_u (local.get $n) (i32.const 31)))
        (local.set $n (i32.and (local.get $n) (i32.const 0x7fffffff)))
        (block $b1 (loop $l1
          (br_if $b1 (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $h (call $mix (local.get $h)
            (if (result i32) (local.get $wide)
              (then (i32.load16_u (i32.add (local.get $sp) (i32.shl (local.get $i) (i32.const 1)))))
              (else (i32.load8_u (i32.add (local.get $sp) (local.get $i)))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l1)))
        (local.set $i (i32.const 0))
        (block $b2 (loop $l2
          (br_if $b2 (i32.ge_u (local.get $i) (i32.const 15)))
          (local.set $h (call $mix (local.get $h)
            (i32.load (i32.add (i32.add (local.get $p) (i32.const 8)) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l2)))
        (i32.store (i32.const 600) (local.get $h))
        (i32.store (i32.const 512) (i32.const 600))
        (i32.store (i32.const 516) (i32.const 65536))
        (i32.const 512))
    )
    (core instance $m (instantiate $M))
    (func (export "uf")
      (param "s" string) (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32) (result string)
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f
      (param "s" string) (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32) (result string)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; utf16 "a" U+00E9 U+20AC U+1F600 (surrogate pair D83D DE00): 5 code units
      (data (i32.const 64) "a\00\e9\00\ac\20\3d\d8\00\de"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32)))
      (func $mix (param $h i32) (param $x i32) (result i32)
        (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $x)))
      (func (export "run") (result i32)
        (local $i i32) (local $h i32) (local $rp i32) (local $rl i32)
        (i32.store (i32.const 128) (i32.const 64))
        (i32.store (i32.const 132) (i32.const 5))
        (block $b0 (loop $l0
          (br_if $b0 (i32.ge_u (local.get $i) (i32.const 15)))
          (i32.store (i32.add (i32.const 136) (i32.shl (local.get $i) (i32.const 2)))
            (i32.add (i32.mul (local.get $i) (i32.const 7)) (i32.const 3)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l0)))
        (call $f (i32.const 128) (i32.const 256))
        (local.set $rp (i32.load (i32.const 256)))
        (local.set $rl (i32.load (i32.const 260)))
        (local.set $h (local.get $rl))
        (local.set $i (i32.const 0))
        (block $b1 (loop $l1
          (br_if $b1 (i32.ge_u (local.get $i) (local.get $rl)))
          (local.set $h (call $mix (local.get $h)
            (i32.load16_u (i32.add (local.get $rp) (i32.shl (local.get $i) (i32.const 1))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l1)))
        (local.get $h))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
