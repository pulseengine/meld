(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; params-ptr: [list ptr, list len, 15 x u32]; hashes everything
      (func (export "uf") (param $p i32) (result i32)
        (local $h i32) (local $i i32) (local $j i32) (local $lp i32) (local $n i32) (local $sp i32) (local $sl i32)
        (local.set $lp (i32.load (local.get $p)))
        (local.set $n (i32.load offset=4 (local.get $p)))
        (local.set $h (i32.add (i32.const 527) (local.get $n)))
        (block $done (loop $L
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $sp (i32.load (i32.add (local.get $lp) (i32.shl (local.get $i) (i32.const 3)))))
          (local.set $sl (i32.load offset=4 (i32.add (local.get $lp) (i32.shl (local.get $i) (i32.const 3)))))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $sl)))
          (local.set $j (i32.const 0))
          (block $sd (loop $S
            (br_if $sd (i32.ge_u (local.get $j) (local.get $sl)))
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
              (i32.load16_u (i32.add (local.get $sp) (i32.shl (local.get $j) (i32.const 1))))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $S)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $L)))
        (local.set $i (i32.const 0))
        (block $d2 (loop $E
          (br_if $d2 (i32.ge_u (local.get $i) (i32.const 15)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (i32.load (i32.add (i32.add (local.get $p) (i32.const 8)) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $E)))
        (local.get $h))
    )
    (core instance $m (instantiate $M))
    (type $ft (func (param "xs" (list string))
      (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32)
      (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32)
      (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32)
      (result u32)))
    (func (export "uf") (type $ft)
      (canon lift (core func $m "uf") string-encoding=utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (type $ft (func (param "xs" (list string))
      (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32)
      (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32)
      (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32)
      (result u32)))
    (import "uf" (func $f (type $ft)))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
                     (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      ;; "h\u{e9}\u{20ac}" , "" , U+1F600 + "x" , "\u{3a9}mega 42"
      (data (i32.const 128) "h\00\e9\00\ac\20")
      (data (i32.const 144) "\3d\d8\00\de\78\00")
      (data (i32.const 160) "\a9\03m\00e\00g\00a\00 \004\002\00")
      (data (i32.const 192) "\80\00\00\00\03\00\00\00\88\00\00\00\00\00\00\00\90\00\00\00\03\00\00\00\a0\00\00\00\08\00\00\00"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32) (result i32)))
      (func (export "run") (result i32)
        (local $i i32)
        (i32.store (i32.const 256) (i32.const 192))
        (i32.store (i32.const 260) (i32.const 4))
        (block $d (loop $L
          (br_if $d (i32.ge_u (local.get $i) (i32.const 15)))
          (i32.store (i32.add (i32.const 264) (i32.shl (local.get $i) (i32.const 2)))
            (i32.add (i32.mul (i32.mul (local.get $i) (local.get $i)) (i32.const 7919)) (i32.const 13)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $L)))
        (call $f (i32.const 256)))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
