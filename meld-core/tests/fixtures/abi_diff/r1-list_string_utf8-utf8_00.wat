(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (data (i32.const 128) "\c3\a9\e2\82\ac\f0\9f\98\80")
      (data (i32.const 160) "hello")
      ;; builds list<string> of 4 elements; the last one points past the end of memory
      (func (export "uf") (result i32)
        (i32.store (i32.const 256) (i32.const 128))
        (i32.store (i32.const 260) (i32.const 9))
        (i32.store (i32.const 264) (i32.const 160))
        (i32.store (i32.const 268) (i32.const 0))
        (i32.store (i32.const 272) (i32.const 160))
        (i32.store (i32.const 276) (i32.const 5))
        (i32.store (i32.const 280) (i32.const 65528))
        (i32.store (i32.const 284) (i32.const 16))
        (i32.store (i32.const 512) (i32.const 256))
        (i32.store (i32.const 516) (i32.const 4))
        (i32.const 512))
    )
    (core instance $m (instantiate $M))
    (func (export "uf") (result (list string))
      (canon lift (core func $m "uf") string-encoding=utf8
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (result (list string))))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 4096))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r)))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=utf8
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32)))
      (func (export "run") (result i32)
        (local $h i32) (local $lp i32) (local $n i32) (local $i i32) (local $ep i32) (local $sp i32) (local $sl i32) (local $j i32)
        (call $f (i32.const 2048))
        (local.set $lp (i32.load (i32.const 2048)))
        (local.set $n (i32.load (i32.const 2052)))
        (local.set $h (local.get $n))
        (loop $L
          (if (i32.lt_u (local.get $i) (local.get $n)) (then
            (local.set $ep (i32.add (local.get $lp) (i32.shl (local.get $i) (i32.const 3))))
            (local.set $sp (i32.load (local.get $ep)))
            (local.set $sl (i32.load offset=4 (local.get $ep)))
            (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $sl)))
            (local.set $j (i32.const 0))
            (block $B (loop $K
              (br_if $B (i32.ge_u (local.get $j) (local.get $sl)))
              (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load8_u (i32.add (local.get $sp) (local.get $j)))))
              (local.set $j (i32.add (local.get $j) (i32.const 1)))
              (br $K)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $L))))
        (local.get $h))
    )
    (core instance $main (instantiate $Main
      (with "" (instance (export "mem" (memory $libc "mem")) (export "uf" (func $f'))))))
    (func (export "run") (result u32) (canon lift (core func $main "run")))
  )
  (instance $c (instantiate $C))
  (instance $d (instantiate $D (with "uf" (func $c "uf"))))
  (export "run" (func $d "run"))
)
