(component
  (component $C
    (core module $M
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (func $hs (param $p i32) (param $t i32) (param $h i32) (result i32) (local $n i32) (local $i i32) (local $w i32)
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $t)))
        (local.set $w (i32.shr_u (local.get $t) (i32.const 31)))
        (local.set $n (i32.and (local.get $t) (i32.const 0x7fffffff)))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (if (result i32) (local.get $w)
              (then (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1)))))
              (else (i32.load8_u (i32.add (local.get $p) (local.get $i)))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.get $h))
      (func $hl (param $lp i32) (param $ln i32) (param $h i32) (result i32) (local $i i32) (local $e i32)
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $ln)))
          (local.set $e (i32.add (local.get $lp) (i32.shl (local.get $i) (i32.const 3))))
          (local.set $h (call $hs (i32.load (local.get $e)) (i32.load offset=4 (local.get $e)) (local.get $h)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.get $h))
      (func (export "uf") (param $p i32) (result i32) (local $h i32) (local $i i32)
        (local.set $h (call $hl (i32.load (local.get $p)) (i32.load offset=4 (local.get $p)) (i32.const 0)))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (i32.const 15)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (i32.load offset=8 (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 2))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (i32.store (i32.const 512) (local.get $h))
        (i32.store (i32.const 516) (i32.const 600))
        (i32.store (i32.const 520) (i32.const 3))
        (i32.store (i32.const 600) (i32.const 640)) (i32.store (i32.const 604) (i32.const 4))
        (i32.store (i32.const 608) (i32.const 656)) (i32.store (i32.const 612) (i32.const 0x80000003))
        ;; element 2: utf16 string whose 8 code units run past the end of memory
        (i32.store (i32.const 616) (i32.const 65530)) (i32.store (i32.const 620) (i32.const 0x80000008))
        (i32.const 512))
      (data (i32.const 640) "caf\e9")
      (data (i32.const 656) "\ac\20\34\d8\1e\dd"))
    (core instance $m (instantiate $M))
    (func (export "uf") (param "l" (list string)) (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32) (result (tuple u32 (list string)))
      (canon lift (core func $m "uf") string-encoding=latin1+utf16
        (memory (core memory $m "mem")) (realloc (core func $m "realloc"))))
  )
  (component $D
    (import "uf" (func $f (param "l" (list string)) (param "a0" u32) (param "a1" u32) (param "a2" u32) (param "a3" u32) (param "a4" u32) (param "a5" u32) (param "a6" u32) (param "a7" u32) (param "a8" u32) (param "a9" u32) (param "a10" u32) (param "a11" u32) (param "a12" u32) (param "a13" u32) (param "a14" u32) (result (tuple u32 (list string)))))
    (core module $Libc
      (memory (export "mem") 1)
      (global $next (mut i32) (i32.const 1024))
      (func (export "realloc") (param $old i32) (param $osize i32) (param $align i32) (param $nsize i32) (result i32)
        (local $r i32)
        (if (i32.and (i32.ne (local.get $old) (i32.const 0)) (i32.le_u (local.get $nsize) (local.get $osize)))
          (then (return (local.get $old))))
        (global.set $next (i32.and (i32.add (global.get $next) (i32.const 7)) (i32.const -8)))
        (local.set $r (global.get $next))
        (global.set $next (i32.add (global.get $next) (local.get $nsize)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then (memory.copy (local.get $r) (local.get $old) (local.get $osize))))
        (local.get $r))
      (data (i32.const 64) "\61\e9")
      (data (i32.const 72) "\ac\20\3d\d8\00\de\78\00hello")
      (data (i32.const 96) "\40\00\00\00\02\00\00\00\46\00\00\00\00\00\00\00\48\00\00\00\04\00\00\80\50\00\00\00\05\00\00\00")
      (data (i32.const 128) "\60\00\00\00\04\00\00\00"))
    (core instance $libc (instantiate $Libc))
    (core func $f' (canon lower (func $f) string-encoding=latin1+utf16
      (memory (core memory $libc "mem")) (realloc (core func $libc "realloc"))))
    (core module $Main
      (import "" "mem" (memory 1))
      (import "" "uf" (func $f (param i32 i32)))
      (func $hs (param $p i32) (param $t i32) (param $h i32) (result i32) (local $n i32) (local $i i32) (local $w i32)
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (local.get $t)))
        (local.set $w (i32.shr_u (local.get $t) (i32.const 31)))
        (local.set $n (i32.and (local.get $t) (i32.const 0x7fffffff)))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
            (if (result i32) (local.get $w)
              (then (i32.load16_u (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 1)))))
              (else (i32.load8_u (i32.add (local.get $p) (local.get $i)))))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.get $h))
      (func (export "run") (result i32) (local $i i32) (local $h i32) (local $lp i32) (local $e i32)
        (loop $fill
          (i32.store offset=136 (i32.shl (local.get $i) (i32.const 2)) (i32.add (i32.mul (local.get $i) (i32.const 7)) (i32.const 3)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $fill (i32.lt_u (local.get $i) (i32.const 15))))
        (call $f (i32.const 128) (i32.const 256))
        (local.set $h (i32.load (i32.const 256)))
        (local.set $lp (i32.load (i32.const 260)))
        (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31)) (i32.load (i32.const 264))))
        (local.set $i (i32.const 0))
        (block $done (loop $l
          (br_if $done (i32.ge_u (local.get $i) (i32.load (i32.const 264))))
          (local.set $e (i32.add (local.get $lp) (i32.shl (local.get $i) (i32.const 3))))
          (local.set $h (call $hs (i32.load (local.get $e)) (i32.load offset=4 (local.get $e)) (local.get $h)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l)))
        (local.get $h))
    )
    (core instance $main (instantiate $Main
