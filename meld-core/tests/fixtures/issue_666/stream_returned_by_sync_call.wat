(component
  (component $A
    (type $s (stream u32))
    (core func $snew (canon stream.new $s))
    (core func $sdropw (canon stream.drop-writable $s))
    (core module $m
      (import "b" "snew" (func $snew (result i64)))
      (import "b" "sdropw" (func $sdropw (param i32)))
      (func (export "get") (result i32)
        (local $p i64)
        ;; burn one pair so A's handles are not small
        (drop (call $snew))
        (local.set $p (call $snew))
        (call $sdropw (i32.wrap_i64 (i64.shr_u (local.get $p) (i64.const 32))))
        (i32.wrap_i64 (local.get $p))))
    (core instance $b (export "snew" (func $snew)) (export "sdropw" (func $sdropw)))
    (core instance $i (instantiate $m (with "b" (instance $b))))
    (func $get (result $s) (canon lift (core func $i "get")))
    (export "get" (func $get)))
  (component $B
    (type $s (stream u32))
    (import "get" (func $get (result $s)))
    (core func $get (canon lower (func $get)))
    (core func $sdropr (canon stream.drop-readable $s))
    (core module $m
      (import "a" "get" (func $get (result i32)))
      (import "b" "sdropr" (func $sdropr (param i32)))
      (func (export "run") (result i32)
        (local $h i32)
        (local.set $h (call $get))
        (call $sdropr (local.get $h))
        (local.get $h)))
    (core instance $a (export "get" (func $get)))
    (core instance $b (export "sdropr" (func $sdropr)))
    (core instance $i (instantiate $m (with "a" (instance $a)) (with "b" (instance $b))))
    (func $run (result u32) (canon lift (core func $i "run")))
    (export "run" (func $run)))
  (instance $a (instantiate $A))
  (instance $b (instantiate $B (with "get" (func $a "get"))))
  (export "run" (func $b "run")))
