# rivet: verifies SR-88
#
# SR-88 / #447: the one target that runs every Rocq proof.
#
# meld carries 14,487 lines of Rocq across 28 files — 350 `Qed`, 0 `Admitted` —
# and until this existed nothing re-checked any of it. Doubly unreachable: all
# 14 `rocq_proof_test` targets are tagged `manual`, so `//...` skips them, and
# no workflow invoked bazel at all, so nothing named them either.
#
# The `manual` tags STAY, including on this suite. `rules_rocq_rust` needs nix,
# and a bare `bazel test //...` on a runner without it should not start failing.
# `manual` suppresses WILDCARD EXPANSION, not explicit reference — so listing
# the members here reaches them, wildcards stay fast, and exactly one named
# target runs the proofs: `bazel test //proofs:verify_all`.
#
# Members are listed EXPLICITLY rather than globbed. A glob that silently
# matches nothing is how a proof gate reports success while selecting zero
# tests; an explicit list that loses a member shows up as a diff. The workflow
# additionally fails on bazel's exit 4 (NO TESTS MATCHED) rather than tolerating
# it — see .github/workflows/proofs.yml.
test_suite(
    name = "verify_all",
    tags = ["manual"],
    tests = [
        ":adapter_proofs_test",
        ":attestation_proofs_test",
        ":merger_proofs_test",
        ":parser_proofs_test",
        ":resolver_proofs_test",
        ":rewriter_proofs_test",
        ":segments_proofs_test",
        "//proofs/rust_verified:index_map_proofs_test",
        "//proofs/rust_verified:merger_core_proofs_test",
        "//proofs/rust_verified:resolver_core_proofs_test",
        "//proofs/transformations/adapter:adapter_spec_test",
        "//proofs/transformations/adapter:copy_layout_proofs_test",
        "//proofs/spec:alias_spec_test",
        "//proofs/spec:p1_adapter_spec_test",
        "//proofs/transformations/merge:merge_spec_test",
        "//proofs/transformations/resolve:resolve_spec_test",
    ],
)
